<UserControl x:Class="QLPT.WPF.Controls.CrudTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════ TOOLBAR ══════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">

            <!-- Ô tìm kiếm -->
            <Border DockPanel.Dock="Left" Width="300" Height="36"
                    Background="{DynamicResource Win11SurfaceBrush}"
                    BorderBrush="{DynamicResource Win11BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10,0"
                    Margin="0,0,10,0">
                <DockPanel>
                    <md:PackIcon Kind="Magnify" Width="16" Height="16"
                                 DockPanel.Dock="Left" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                    <Button DockPanel.Dock="Right" x:Name="ClearSearchBtn"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="22" Height="22" Padding="0" Visibility="Collapsed"
                            Click="ClearSearch_Click" ToolTip="Xóa tìm kiếm"
                            Foreground="{DynamicResource Win11TextSecondaryBrush}">
                        <md:PackIcon Kind="Close" Width="13" Height="13"/>
                    </Button>
                    <TextBox x:Name="SearchBox" BorderThickness="0" FontSize="13"
                             Background="Transparent" Margin="8,0,0,0"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource Win11TextPrimaryBrush}"
                             CaretBrush="{DynamicResource Win11TextPrimaryBrush}"
                             md:HintAssist.Hint="{Binding SearchHint, ElementName=Root}"
                             md:TextFieldAssist.DecorationVisibility="Collapsed"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown"/>
                </DockPanel>
            </Border>

            <!-- Bộ lọc riêng của trang -->
            <ContentPresenter DockPanel.Dock="Left" VerticalAlignment="Center"
                              Content="{Binding ExtraFilter, ElementName=Root}"/>

            <!-- Nút chính (ngoài cùng bên phải) -->
            <Button DockPanel.Dock="Right"
                    Command="{Binding AddCommand, ElementName=Root}"
                    Visibility="{Binding ShowAdd, ElementName=Root, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Height="36" Padding="14,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="{Binding AddIcon, ElementName=Root}"
                                 Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AddLabel, ElementName=Root}"
                               Margin="6,0,0,0" FontSize="13"/>
                </StackPanel>
            </Button>

            <!-- Nút nghiệp vụ riêng của trang (Gia hạn, Thu tiền…) -->
            <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Content="{Binding ExtraActions, ElementName=Root}"/>

            <!-- Tải lại -->
            <Button DockPanel.Dock="Right"
                    Command="{Binding ReloadCommand, ElementName=Root}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Width="36" Height="36" Padding="0" Margin="0,0,6,0"
                    VerticalAlignment="Center" ToolTip="Tải lại dữ liệu"
                    Foreground="{DynamicResource Win11TextSecondaryBrush}">
                <md:PackIcon Kind="Refresh" Width="18" Height="18"/>
            </Button>

            <!-- Số dòng -->
            <TextBlock DockPanel.Dock="Right" x:Name="CountLabel"
                       VerticalAlignment="Center" FontSize="12" Margin="0,0,14,0"
                       Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
        </DockPanel>

        <!-- ══════ BẢNG ══════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource Win11SurfaceBrush}"
                BorderBrush="{DynamicResource Win11BorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <DataGrid x:Name="Grid"
                          ItemsSource="{Binding ItemsSource, ElementName=Root}"
                          SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="True" SelectionMode="Single"
                          HeadersVisibility="Column"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          MouseDoubleClick="Grid_MouseDoubleClick">
                    <!-- Màu sắc bảng lấy từ style DataGrid dùng chung trong App.xaml -->

                    <DataGrid.Columns>
                        <!-- Cột thao tác — luôn đứng cuối -->
                        <DataGridTemplateColumn x:Name="ActionCol" Header="" Width="96"
                                                CanUserSort="False" CanUserReorder="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Button Click="RowEdit_Click"
                                                ToolTip="{Binding EditLabel, ElementName=Root}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Width="30" Height="30" Padding="0"
                                                Visibility="{Binding ShowEdit, ElementName=Root, Converter={StaticResource BoolToVis}}"
                                                Foreground="{DynamicResource Win11TextSecondaryBrush}">
                                            <md:PackIcon Kind="PencilOutline" Width="16" Height="16"/>
                                        </Button>
                                        <Button Click="RowDelete_Click"
                                                ToolTip="{Binding DeleteLabel, ElementName=Root}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Width="30" Height="30" Padding="0"
                                                Visibility="{Binding ShowDelete, ElementName=Root, Converter={StaticResource BoolToVis}}"
                                                Foreground="#EF4444">
                                            <md:PackIcon Kind="TrashCanOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Trạng thái rỗng -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,40,0,0" IsHitTestVisible="False">
                    <md:PackIcon Kind="DatabaseOffOutline"
                                 Width="40" Height="40" HorizontalAlignment="Center"
                                 Foreground="{DynamicResource Win11BorderBrush}"/>
                    <TextBlock x:Name="EmptyText" Text="Chưa có dữ liệu"
                               FontSize="13" Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Lỗi -->
                <Border x:Name="ErrorBar" VerticalAlignment="Bottom"
                        Background="#40EF4444" BorderBrush="#EF4444"
                        BorderThickness="0,1,0,0"
                        Padding="14,9" Visibility="Collapsed" CornerRadius="0,0,5,5">
                    <TextBlock Text="{Binding ErrorMessage, ElementName=Root}"
                               Foreground="{DynamicResource Win11TextPrimaryBrush}"
                               FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Đang tải -->
                <Grid Visibility="{Binding IsBusy, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource Win11SurfaceBrush}" Opacity="0.75"/>
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 IsIndeterminate="True" Width="34" Height="34"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
