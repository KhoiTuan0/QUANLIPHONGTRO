<UserControl x:Class="QLPT.WPF.Views.Pages.PhongPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:QLPT.WPF.Controls"
             xmlns:vm="clr-namespace:QLPT.WPF.ViewModels">
    <UserControl.DataContext>
        <vm:PhongViewModel/>
    </UserControl.DataContext>

    <ctl:CrudTable Margin="20,16,20,20"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                   ReloadCommand="{Binding LoadCommand}"
                   AddCommand="{Binding AddCommand}"
                   EditCommand="{Binding EditCommand}"
                   DeleteCommand="{Binding DeleteCommand}"
                   IsBusy="{Binding IsBusy}"
                   ErrorMessage="{Binding ErrorMessage}"
                   AddLabel="Thêm phòng"
                   DeleteLabel="Xóa phòng này"
                   SearchHint="Tìm theo tên phòng, tầng, giá…">

        <ctl:CrudTable.Columns>
            <DataGridTextColumn Header="MÃ"         Binding="{Binding MaPhong}"        Width="0.6*" MinWidth="60"/>
            <DataGridTextColumn Header="TÊN PHÒNG"  Binding="{Binding TenPhong}"       Width="*"/>
            <DataGridTextColumn Header="LOẠI PHÒNG" Binding="{Binding MaLoaiPhong}"    Width="0.9*" MinWidth="90"/>
            <DataGridTextColumn Header="CƠ SỞ"      Binding="{Binding MaCoSo}"         Width="0.7*" MinWidth="70"/>
            <DataGridTextColumn Header="TẦNG"       Binding="{Binding Tang}"           Width="0.6*" MinWidth="60"/>
            <DataGridTextColumn Header="GIÁ THUÊ"   Binding="{Binding GiaThueDisplay}" Width="1.3*" MinWidth="130"/>
            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding TrangThai}"      Width="1.2*" MinWidth="120"/>
            <DataGridTextColumn Header="MÔ TẢ"      Binding="{Binding MoTa}"           Width="*"/>
        </ctl:CrudTable.Columns>
    </ctl:CrudTable>
</UserControl>
