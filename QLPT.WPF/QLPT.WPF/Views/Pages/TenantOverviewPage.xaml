<UserControl x:Class="QLPT.WPF.Views.Pages.TenantOverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QLPT.WPF.ViewModels">
    <UserControl.DataContext>
        <vm:TenantOverviewViewModel/>
    </UserControl.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title + Refresh -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding TenChao}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource Win11TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Command="{Binding LoadCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="Làm mới" Width="36" Height="36" Padding="0"
                    Foreground="{DynamicResource Win11TextSecondaryBrush}"
                    HorizontalAlignment="Right">
                <md:PackIcon Kind="Refresh" Width="18" Height="18"/>
            </Button>
        </DockPanel>

        <!-- Error -->
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Crimson"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <!-- 2-column layout -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column: personal info + notifications -->
            <DockPanel Grid.Column="0">
                <!-- Personal info card -->
                <md:Card DockPanel.Dock="Top" Padding="20" UniformCornerRadius="12" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <md:PackIcon Kind="Account" Width="22" Height="22"
                                         Foreground="{DynamicResource Win11TextPrimaryBrush}"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="Thông tin cá nhân" FontWeight="Bold" FontSize="15"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Họ tên:"     Foreground="{DynamicResource Win11TextSecondaryBrush}" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HoTen}"       FontWeight="Medium" Margin="0,4" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="CCCD:"       Foreground="{DynamicResource Win11TextSecondaryBrush}" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Cccd}"        Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Điện thoại:" Foreground="{DynamicResource Win11TextSecondaryBrush}" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SoDienThoai}" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Email:"      Foreground="{DynamicResource Win11TextSecondaryBrush}" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Email}"       Margin="0,4" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Địa chỉ:"   Foreground="{DynamicResource Win11TextSecondaryBrush}" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DiaChi}"      Margin="0,4" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </md:Card>

                <!-- Notifications card -->
                <md:Card Padding="0" UniformCornerRadius="12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Bell" Width="18" Height="18"
                                             Foreground="{DynamicResource Win11TextPrimaryBrush}"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="Thông báo" FontWeight="SemiBold" FontSize="14"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding ThongBaos}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" GridLinesVisibility="None"
                                  HeadersVisibility="None" BorderThickness="0"
                                  
                                  MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,6">
                                                <TextBlock Text="{Binding TieuDe}" FontWeight="Medium"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding NgayGui}" FontSize="11"
                                                           Foreground="{DynamicResource Win11TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="0.9*" MinWidth="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </md:Card>
            </DockPanel>

            <!-- Right column: contracts + invoices -->
            <DockPanel Grid.Column="2" LastChildFill="True">
                <!-- Contracts -->
                <md:Card DockPanel.Dock="Top" Padding="0" UniformCornerRadius="12" Margin="0,0,0,16">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="FileDocument" Width="18" Height="18"
                                             Foreground="{DynamicResource Win11TextPrimaryBrush}"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="Hợp đồng" FontWeight="SemiBold" FontSize="14"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding HopDongs}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column" BorderThickness="0"
                                  
                                  MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã HĐ"      Binding="{Binding MaHopDong}"    Width="0.8*" MinWidth="80"/>
                                <DataGridTextColumn Header="Phòng"       Binding="{Binding MaPhong}"      Width="0.8*" MinWidth="80"/>
                                <DataGridTextColumn Header="Bắt đầu"    Binding="{Binding NgayBatDau}"   Width="1.1*" MinWidth="110"/>
                                <DataGridTextColumn Header="Hết hạn"    Binding="{Binding NgayKetThuc}"  Width="1.1*" MinWidth="110"/>
                                <DataGridTextColumn Header="Giá thuê/tháng" Binding="{Binding GiaThueThang}" Width="*"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}"    Width="1.2*" MinWidth="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </md:Card>

                <!-- Invoices -->
                <md:Card Padding="0" UniformCornerRadius="12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ReceiptText" Width="18" Height="18"
                                             Foreground="{DynamicResource Win11TextPrimaryBrush}"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="Hóa đơn" FontWeight="SemiBold" FontSize="14"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding HoaDons}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column" BorderThickness="0"
                                  >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã HĐN"     Binding="{Binding MaHoaDon}"  Width="0.8*" MinWidth="80"/>
                                <DataGridTextColumn Header="Tháng/Năm"  Binding="{Binding ThangNam}"  Width="1.1*" MinWidth="110"/>
                                <DataGridTextColumn Header="Tổng tiền"  Binding="{Binding TongTien}"  Width="*"/>
                                <DataGridTextColumn Header="Đã thu"     Binding="{Binding DaThu}"     Width="*"/>
                                <DataGridTextColumn Header="Còn lại"    Binding="{Binding ConLai}"    Width="*"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="1.2*" MinWidth="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </md:Card>
            </DockPanel>
        </Grid>

        <!-- Loading overlay -->
        <Grid Grid.RowSpan="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource Win11ContentBrush}" Opacity="0.6"/>
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Width="48" Height="48"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>

