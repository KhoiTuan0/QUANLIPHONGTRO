<UserControl x:Class="QLPT.WPF.Views.Pages.LoaiPhongPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:QLPT.WPF.Controls"
             xmlns:vm="clr-namespace:QLPT.WPF.ViewModels">
    <UserControl.DataContext>
        <vm:LoaiPhongViewModel/>
    </UserControl.DataContext>

    <ctl:CrudTable Margin="20,16,20,20"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                   ReloadCommand="{Binding LoadCommand}"
                   AddCommand="{Binding AddCommand}"
                   EditCommand="{Binding EditCommand}"
                   DeleteCommand="{Binding DeleteCommand}"
                   IsBusy="{Binding IsBusy}"
                   ErrorMessage="{Binding ErrorMessage}"
                   AddLabel="Thêm loại phòng"
                   DeleteLabel="Xóa loại phòng này"
                   SearchHint="Tìm theo tên loại, diện tích, giá…">
        <ctl:CrudTable.Columns>
            <DataGridTextColumn Header="MÃ"              Binding="{Binding MaLoaiPhong}"       Width="0.6*" MinWidth="60"/>
            <DataGridTextColumn Header="TÊN LOẠI PHÒNG"  Binding="{Binding TenLoaiPhong}"      Width="*"/>
            <DataGridTextColumn Header="DIỆN TÍCH (M²)"  Binding="{Binding DienTich}"          Width="1.1*" MinWidth="110"/>
            <DataGridTextColumn Header="SỐ NGƯỜI TỐI ĐA" Binding="{Binding SoNguoiToiDa}"      Width="1.3*" MinWidth="130"/>
            <DataGridTextColumn Header="GIÁ MẶC ĐỊNH"    Binding="{Binding GiaMacDinhDisplay}" Width="1.4*" MinWidth="140"/>
            <DataGridTextColumn Header="MÔ TẢ"           Binding="{Binding MoTa}"              Width="*"/>
        </ctl:CrudTable.Columns>
    </ctl:CrudTable>
</UserControl>
