<UserControl x:Class="QLPT.WPF.Views.Pages.DatPhongPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ctl="clr-namespace:QLPT.WPF.Controls">

    <ctl:CrudTable Margin="20,16,20,20"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                   ReloadCommand="{Binding LoadCommand}"
                   AddCommand="{Binding DatMoiCommand}"
                   IsBusy="{Binding IsBusy}"
                   ErrorMessage="{Binding ErrorMessage}"
                   AddLabel="Đặt mới"
                   ShowEdit="False"
                   ShowDelete="False"
                   SearchHint="Tìm theo mã đặt phòng, phòng, khách…">

        <!-- Nghiệp vụ riêng: hủy giữ chỗ cho dòng đang chọn -->
        <ctl:CrudTable.ExtraActions>
            <Button Command="{Binding HuyGiuChoCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Height="36" Padding="12,0"
                    Foreground="#EF4444" BorderBrush="#EF4444">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Cancel" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Hủy giữ chỗ" Margin="6,0,0,0" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </ctl:CrudTable.ExtraActions>

        <ctl:CrudTable.Columns>
            <DataGridTextColumn Header="MÃ ĐP"             Binding="{Binding MaDatPhong}"     Width="0.8*" MinWidth="80"/>
            <DataGridTextColumn Header="MÃ PHÒNG"          Binding="{Binding MaPhong}"        Width="0.9*" MinWidth="90"/>
            <DataGridTextColumn Header="MÃ KHÁCH"          Binding="{Binding MaKhach}"        Width="0.9*" MinWidth="90"/>
            <DataGridTextColumn Header="NGÀY ĐẶT"          Binding="{Binding NgayDat}"        Width="1.2*" MinWidth="120"/>
            <DataGridTextColumn Header="NGÀY DỰ KIẾN NHẬN" Binding="{Binding NgayDuKienNhan}" Width="1.5*" MinWidth="150"/>
            <DataGridTextColumn Header="TIỀN CỌC"          Binding="{Binding TienCocDisplay}" Width="1.3*" MinWidth="130"/>
            <DataGridTextColumn Header="TRẠNG THÁI"        Binding="{Binding TrangThai}"      Width="*"/>
        </ctl:CrudTable.Columns>
    </ctl:CrudTable>
</UserControl>
