<Window x:Class="QLPT.WPF.Views.Dialogs.KhachThueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Khách thuê" Style="{StaticResource Win10Dialog}" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}"
        TextElement.FontFamily="{md:MaterialDesignFont}"
        TextElement.FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="28">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="Thêm khách thuê" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource Win11TextPrimaryBrush}" Margin="0,0,0,20"/>

            <TextBox x:Name="TxtHoTen" MaxLength="100" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Họ tên *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtCccd" MaxLength="12" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="CCCD (12 số)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                <TextBox Grid.Column="2" x:Name="TxtSdt" MaxLength="10" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="SĐT (10 số, bắt đầu 0)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" x:Name="CboGioiTinh" md:HintAssist.Hint="Giới tính"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" SelectedIndex="0">
                    <ComboBoxItem Content="Nam"/>
                    <ComboBoxItem Content="Nữ"/>
                    <ComboBoxItem Content="Khác"/>
                </ComboBox>
                <TextBox Grid.Column="2" x:Name="TxtEmail" MaxLength="100" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Email"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            </Grid>

            <TextBox x:Name="TxtDiaChi" MaxLength="300" md:HintAssist.Hint="Địa chỉ"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>

            <TextBlock x:Name="TxtError" Foreground="Crimson" TextWrapping="Wrap" Margin="0,4,0,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Hủy" Style="{StaticResource MaterialDesignFlatButton}"
                        Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnSave" Content="Lưu" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>


