<Window x:Class="QLPT.WPF.Views.Dialogs.SuaChuaCapNhatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:svc="clr-namespace:QLPT.WPF.Services"
        Title="Cập nhật trạng thái sửa chữa" Style="{StaticResource Win10Dialog}" Width="440"
        SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="24">
        <StackPanel>
            <TextBlock Text="Cập nhật trạng thái sửa chữa" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Trạng thái *" Foreground="{DynamicResource Win11TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="CbTrangThai"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,0,16">
                <!-- Đúng bộ trạng thái của bảng YeuCauSuaChua trong CSDL -->
                <ComboBoxItem Content="Chờ tiếp nhận"/>
                <ComboBoxItem Content="Đang sửa"/>
                <ComboBoxItem Content="Đã hoàn thành"/>
            </ComboBox>

            <TextBox x:Name="TxtChiPhi" svc:MoneyInput.IsEnabled="True"
                     md:HintAssist.Hint="Chi phí"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,16"/>

            <DatePicker x:Name="DpNgayHoanThanh"
                        md:HintAssist.Hint="Ngày hoàn thành"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Margin="0,0,0,16"/>

            <TextBlock x:Name="TxtError" Foreground="Crimson"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Hủy"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnSave" Content="Lưu"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>



