<Window x:Class="QLPT.WPF.Views.Dialogs.XuLyViPhamDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:svc="clr-namespace:QLPT.WPF.Services"
        Title="Xử lý vi phạm" Style="{StaticResource Win10Dialog}" Width="460"
        SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="24">
            <StackPanel>
                <TextBlock Text="Xử lý vi phạm" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                <!-- Vi phạm đang xử lý, để soát lại trước khi chốt -->
                <Border Background="{DynamicResource Win11ContentBrush}"
                        BorderBrush="{DynamicResource Win11BorderBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="12,9" Margin="0,0,0,16">
                    <TextBlock x:Name="TxtInfo" TextWrapping="Wrap" FontSize="13"/>
                </Border>

                <TextBlock Text="Hình thức xử lý *" FontSize="12" Margin="0,0,0,4"
                           Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                <ComboBox x:Name="CbHinhThuc" IsEditable="True"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,0,16">
                    <ComboBoxItem Content="Nhắc nhở"/>
                    <ComboBoxItem Content="Cảnh cáo"/>
                    <ComboBoxItem Content="Phạt tiền"/>
                    <ComboBoxItem Content="Bồi thường thiệt hại"/>
                    <ComboBoxItem Content="Chấm dứt hợp đồng"/>
                </ComboBox>

                <TextBox x:Name="TxtTienPhat" svc:MoneyInput.IsEnabled="True"
                         md:HintAssist.Hint="Tiền phạt"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,16"/>

                <CheckBox x:Name="ChkThongBao" IsChecked="True"
                          Content="Gửi thông báo kết quả xử lý cho khách"
                          Margin="0,0,0,12"/>

                <TextBlock x:Name="TxtError" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy" IsCancel="True"
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSave" Content="Xác nhận xử lý"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="BtnSave_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
