<Window x:Class="QLPT.WPF.Views.Dialogs.DanhSachPhanHoiDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Phản hồi của khách" Style="{StaticResource Win10Dialog}" Width="560" Height="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Phản hồi của khách" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="TxtTieuDe" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Content="Đóng" IsCancel="True" HorizontalAlignment="Right"
                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,12,0,0"/>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LstPhanHoi">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Win11ContentBrush}"
                                    BorderBrush="{DynamicResource Win11BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding NgayGui}" FontSize="11"
                                                   Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="AccountCircleOutline" Width="16" Height="16"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding NguoiGui}" FontWeight="SemiBold"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding NoiDung}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="TxtEmpty" Text="Chưa có phản hồi nào." Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
        </Grid>
    </DockPanel>
</Window>
