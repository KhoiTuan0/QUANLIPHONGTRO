<Window x:Class="QLPT.WPF.Views.Dialogs.SuaChuaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Thêm yêu cầu sửa chữa" Style="{StaticResource Win10Dialog}" Width="440"
        SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="24">
        <StackPanel>
            <TextBlock Text="Thêm yêu cầu sửa chữa" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBox x:Name="TxtMaHopDong" MaxLength="9" md:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                     md:HintAssist.Hint="Mã hợp đồng *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,16"/>

            <TextBox x:Name="TxtMoTa" MaxLength="500"
                     md:HintAssist.Hint="Mô tả yêu cầu *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="100"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,16"/>

            <DatePicker x:Name="DpNgayYeuCau"
                        md:HintAssist.Hint="Ngày yêu cầu *"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Margin="0,0,0,16"/>

            <TextBlock x:Name="TxtError" Foreground="Crimson"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Hủy"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnSave" Content="Lưu"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>



