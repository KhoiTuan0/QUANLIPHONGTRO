<Window x:Class="QLPT.WPF.Views.Dialogs.CuTruDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Thêm người ở cùng" Style="{StaticResource Win10Dialog}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Thêm người ở cùng" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource Win11TextPrimaryBrush}" Margin="0,0,0,4"/>
        <TextBlock Text="Số người không được vượt quá sức chứa của loại phòng."
                   FontSize="12" Margin="0,0,0,16"
                   Foreground="{DynamicResource Win11TextSecondaryBrush}"/>

        <!-- Điền sẵn từ dòng đang chọn; sửa được để thêm vào hợp đồng khác -->
        <TextBox x:Name="TxtMaHopDong" MaxLength="9" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Mã hợp đồng *"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
        <TextBox x:Name="TxtMaKhach" MaxLength="9" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Mã khách *"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
        <DatePicker x:Name="DpNgayVao" md:HintAssist.Hint="Ngày vào *"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>

        <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" IsCancel="True" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button Content="Thêm" Click="BtnOk_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
