<Window x:Class="QLPT.WPF.Views.Dialogs.TaiKhoanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Tài khoản" Style="{StaticResource Win10Dialog}" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}"
        TextElement.FontFamily="{md:MaterialDesignFont}"
        TextElement.FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="28">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="Thêm tài khoản" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource Win11TextPrimaryBrush}" Margin="0,0,0,20"/>

            <TextBox x:Name="TxtTenDangNhap" MaxLength="50" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Tên đăng nhập *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"
                     x:FieldModifier="private"/>
            <PasswordBox x:Name="TxtMatKhau" md:HintAssist.Hint="Mật khẩu *"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,0,0,12"
                         x:FieldModifier="private"/>

            <ComboBox x:Name="CboVaiTro" md:HintAssist.Hint="Vai trò"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,0,12" SelectedIndex="1">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Customer"/>
            </ComboBox>

            <TextBox x:Name="TxtMaKhach" MaxLength="9" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Mã khách thuê (nếu có)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>

            <TextBlock x:Name="TxtError" Foreground="Crimson" TextWrapping="Wrap" Margin="0,4,0,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Hủy" Style="{StaticResource MaterialDesignFlatButton}"
                        Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnSave" Content="Lưu" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>


