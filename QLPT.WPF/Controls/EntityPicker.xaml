<UserControl x:Class="QLPT.WPF.Controls.EntityPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">
    <StackPanel>
        <StackPanel x:Name="InputPanel">
            <TextBox x:Name="TxtSearch" TextChanged="Search_Changed" MaxLength="100" Visibility="Collapsed"
                     md:HintAssist.Hint="{Binding SearchHint, ElementName=Root}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,6"
                     md:TextFieldAssist.CharacterCounterVisibility="Collapsed"/>
            <ComboBox x:Name="CbOptions" DisplayMemberPath="Label" IsEditable="True" IsTextSearchEnabled="False"
                      StaysOpenOnEdit="True"
                      SelectionChanged="Options_Changed" MaxDropDownHeight="280"
                      md:HintAssist.Hint="{Binding Hint, ElementName=Root}"
                      ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"
                      VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
        </StackPanel>
        <DockPanel Margin="0,4,0,0">
            <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
        </DockPanel>
    </StackPanel>
</UserControl>
