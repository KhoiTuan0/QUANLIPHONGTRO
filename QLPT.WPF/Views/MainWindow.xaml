<Window x:Class="QLPT.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Quản lý phòng trọ — KLCN052"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        Background="{DynamicResource Win11ContentBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ SIDEBAR ═══════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource Win11SidebarBrush}"
                BorderThickness="0"
                Width="{Binding IsMenuOpen, Converter={StaticResource BoolToSidebarWidth}}">
            <DockPanel>

                <!-- Hamburger + logo -->
                <Border DockPanel.Dock="Top" Padding="6,10,6,6">
                    <StackPanel Orientation="Horizontal">
                        <Button Width="36" Height="36" Padding="0"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding ToggleMenuCommand}"
                                Foreground="{DynamicResource SidebarTextBrush}"
                                ToolTip="Ẩn / hiện menu">
                            <md:PackIcon Kind="Menu" Width="18" Height="18"/>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                                    Visibility="{Binding IsMenuOpen, Converter={StaticResource BoolToVis}}">
                            <Border Width="26" Height="26" CornerRadius="6"
                                    Background="{DynamicResource SidebarActiveBrush}">
                                <md:PackIcon Kind="HomeCity" Width="16" Height="16"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="{DynamicResource SidebarTextBrush}"/>
                            </Border>
                            <TextBlock Text="QLPT" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource SidebarTextBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Search / filter: nền trắng mờ trên nền sidebar -->
                <Border DockPanel.Dock="Top" Margin="10,2,10,8"
                        Visibility="{Binding IsMenuOpen, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource SidebarSearchBrush}"
                            BorderBrush="{DynamicResource SidebarDividerBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8,0">
                        <DockPanel>
                            <md:PackIcon Kind="Magnify" Width="15" Height="15"
                                         DockPanel.Dock="Left" VerticalAlignment="Center"
                                         Foreground="{DynamicResource SidebarTextSecondaryBrush}"/>
                            <TextBox x:Name="SearchBox"
                                     Height="30" FontSize="12" BorderThickness="0"
                                     Background="Transparent" VerticalContentAlignment="Center"
                                     Margin="6,0,0,0"
                                     Foreground="{DynamicResource SidebarTextBrush}"
                                     CaretBrush="{DynamicResource SidebarTextBrush}"
                                     md:HintAssist.Hint="Tìm chức năng…  (Ctrl+K)"
                                     md:TextFieldAssist.DecorationVisibility="Collapsed"
                                     TextChanged="SearchBox_TextChanged"
                                     KeyDown="SearchBox_KeyDown"/>
                        </DockPanel>
                    </Border>
                </Border>

                <!-- Bottom: user + logout (declared before Fill so it docks correctly) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="6,0,6,10">
                    <Separator Background="{DynamicResource SidebarDividerBrush}" Margin="4,6"/>

                    <!-- Người dùng: avatar chữ cái đầu + tên + vai trò -->
                    <StackPanel Orientation="Horizontal" Margin="8,2,0,6"
                                Visibility="{Binding IsMenuOpen, Converter={StaticResource BoolToVis}}">
                        <Border Width="30" Height="30" CornerRadius="15"
                                Background="{DynamicResource SidebarActiveBrush}">
                            <TextBlock Text="{Binding UserInitial}" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SidebarTextBrush}"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SidebarTextBrush}"/>
                            <TextBlock Text="{Binding UserRole}" FontSize="10"
                                       Foreground="{DynamicResource SidebarTextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Height="36" Padding="10,0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding LogoutCommand}"
                            ToolTip="Đăng xuất"
                            Foreground="{DynamicResource SidebarTextSecondaryBrush}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Logout" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Đăng xuất" Margin="10,0,0,0" FontSize="13"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsMenuOpen, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Nav items (fills remaining space, scrolls) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel x:Name="NavPanel" Margin="6,0,6,4"/>
                        <TextBlock x:Name="NoResultLabel"
                                   Text="Không tìm thấy chức năng nào"
                                   FontSize="12" TextWrapping="Wrap"
                                   Margin="14,12,14,0" Visibility="Collapsed"
                                   Foreground="{DynamicResource SidebarTextSecondaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ═══════════ CONTENT ═══════════ -->
        <DockPanel Grid.Column="1">

            <!-- Title bar: breadcrumb left, theme toggle right -->
            <Border DockPanel.Dock="Top" Height="44"
                    Background="{DynamicResource Win11SurfaceBrush}"
                    BorderBrush="{DynamicResource Win11BorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel Margin="20,0,12,0">

                    <!-- Right: theme toggle -->
                    <Button DockPanel.Dock="Right"
                            Width="36" Height="36" Padding="0"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding ToggleThemeCommand}"
                            Foreground="{DynamicResource Win11TextSecondaryBrush}"
                            VerticalAlignment="Center"
                            ToolTip="Chuyển chế độ sáng / tối">
                        <md:PackIcon Kind="{Binding ThemeIcon}" Width="18" Height="18"/>
                    </Button>

                    <!-- Left: breadcrumb  "Nhóm  ›  Trang" -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPageGroup}" FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Win11TextPrimaryBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Page content -->
            <Border Background="{DynamicResource Win11ContentBrush}">
                <ContentPresenter Content="{Binding CurrentPage}"/>
            </Border>

        </DockPanel>
    </Grid>
</Window>
