<Window x:Class="QLPT.WPF.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Đăng ký tài khoản khách thuê"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextElement.FontFamily="{md:MaterialDesignFont}">

    <Border Padding="36,32">
        <StackPanel>
            <TextBlock Text="Tạo tài khoản mới" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,0,0,4"/>
            <TextBlock Text="Tài khoản mặc định là vai trò Khách thuê"
                       Foreground="{DynamicResource Win11TextSecondaryBrush}" FontSize="12" Margin="0,0,0,24"/>

            <TextBox x:Name="TxtUser" MaxLength="50" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Tên đăng nhập *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
            <PasswordBox x:Name="PbPass" md:HintAssist.Hint="Mật khẩu * (tối thiểu 6 ký tự)"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,0,0,12"/>
            <!-- Ô mật khẩu bị che: bắt nhập lại để gõ nhầm thì phát hiện ngay, không bị khóa ngoài -->
            <PasswordBox x:Name="PbPass2" md:HintAssist.Hint="Nhập lại mật khẩu *"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,0,0,12"/>
            <TextBox x:Name="TxtHoTen" MaxLength="100" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Họ và tên *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
            <TextBox x:Name="TxtPhone" MaxLength="10" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Số điện thoại"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
            <TextBox x:Name="TxtCccd" MaxLength="12" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="CCCD (12 chữ số)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
            <TextBox x:Name="TxtEmail" MaxLength="100" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Email"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>

            <TextBlock x:Name="TxtMsg" TextWrapping="Wrap" FontSize="12"
                       Foreground="Crimson" Margin="0,4,0,12" MinHeight="18"/>

            <Button Content="ĐĂNG KÝ TÀI KHOẢN"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#388E3C" BorderBrush="#388E3C"
                    Height="44" FontWeight="Bold" Click="BtnRegister_Click" Margin="0,0,0,8"/>
            <Button Content="← Quay lại đăng nhập"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Click="BtnBack_Click"/>
        </StackPanel>
    </Border>
</Window>
