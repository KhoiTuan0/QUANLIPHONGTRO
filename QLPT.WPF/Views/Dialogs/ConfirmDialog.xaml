<Window x:Class="QLPT.WPF.Views.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">

    <!-- Viền ngoài tự vẽ vì đã tắt khung hệ thống -->
    <Border Background="{DynamicResource Win11SurfaceBrush}"
            BorderBrush="{DynamicResource Win11BorderBrush}"
            BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="26,24,26,20">

            <!-- Huy hiệu icon + tiêu đề -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border x:Name="IconBadge" Width="42" Height="42" CornerRadius="21"
                        Background="#1AEF4444" VerticalAlignment="Top">
                    <md:PackIcon x:Name="Icon" Kind="TrashCanOutline"
                                 Width="22" Height="22" Foreground="#EF4444"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="320">
                    <TextBlock x:Name="TxtTitle" Text="Xác nhận xóa"
                               FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource Win11TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtMessage" Text="Bạn có chắc muốn xóa mục này?"
                               FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Tên đối tượng bị tác động, cho người dùng soát lại trước khi bấm -->
            <Border x:Name="ItemBox" Visibility="Collapsed"
                    Background="{DynamicResource Win11ContentBrush}"
                    BorderBrush="{DynamicResource Win11BorderBrush}"
                    BorderThickness="1" CornerRadius="5"
                    Padding="12,9" Margin="0,0,0,14">
                <TextBlock x:Name="TxtItem" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Win11TextPrimaryBrush}"/>
            </Border>

            <!-- Cảnh báo không hoàn tác được -->
            <StackPanel x:Name="WarnBox" Orientation="Horizontal" Margin="0,0,0,18"
                        Visibility="Collapsed">
                <md:PackIcon Kind="AlertOutline" Width="15" Height="15"
                             Foreground="#F59E0B" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtWarn" Text="Thao tác này không thể hoàn tác."
                           FontSize="12" Margin="7,0,0,0" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="#B45309"/>
            </StackPanel>

            <!-- Hành động: Hủy đứng trước để tránh bấm nhầm -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Hủy"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="38" Padding="20,0" Margin="0,0,10,0"
                        FontSize="13" IsCancel="True"
                        Click="BtnCancel_Click"
                        Foreground="{DynamicResource Win11TextSecondaryBrush}"
                        BorderBrush="{DynamicResource Win11BorderBrush}"/>
                <Button x:Name="BtnOk" Content="Xóa"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="38" Padding="24,0" FontSize="13" FontWeight="SemiBold"
                        Background="#EF4444" BorderBrush="#EF4444" Foreground="White"
                        md:ElevationAssist.Elevation="Dp0"
                        Click="BtnOk_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
