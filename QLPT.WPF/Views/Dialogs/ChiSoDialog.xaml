<Window x:Class="QLPT.WPF.Views.Dialogs.ChiSoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:QLPT.WPF.Controls"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Thêm chỉ số điện nước" Style="{StaticResource Win10Dialog}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtTitle" Text="Thêm chỉ số điện nước" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource Win11TextPrimaryBrush}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,0,0">
            <ctl:EntityPicker  x:Name="PickMaPhong" Source="PhongDangThue" Hint="Phòng đang thuê *" SearchHint="Tìm tên phòng, cơ sở hoặc mã" Margin="0,0,0,12"/>
            <ComboBox x:Name="CbLoai" md:HintAssist.Hint="Loại *"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,10"
                      SelectionChanged="CbLoai_SelectionChanged">
                <ComboBoxItem Content="Điện" IsSelected="True"/>
                <ComboBoxItem Content="Nước"/>
            </ComboBox>
            <TextBox x:Name="TxtThangNam" MaxLength="7" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Tháng năm (yyyy-MM) *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
            <TextBox x:Name="TxtChiSoCu" MaxLength="12" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Chỉ số cũ *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
            <TextBox x:Name="TxtChiSoMoi" MaxLength="12" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Chỉ số mới *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" TextChanged="ChiSoMoi_Changed"/>

            <StackPanel x:Name="OcrPanel" Margin="0,14,0,0">
                <TextBlock Text="Đọc chỉ số điện từ ảnh (tùy chọn)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Text="OCR chỉ gợi ý; nếu đọc trên máy chưa rõ, ảnh sẽ được gửi qua API tới dịch vụ AI. Xem ảnh, chỉnh số mới nếu cần rồi xác nhận trước khi lưu."
                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                           Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                <Image x:Name="ImgMeter" Height="130" Stretch="Uniform" Visibility="Collapsed" Margin="0,0,0,8"/>
                <Image x:Name="ImgNumber" Height="65" Stretch="Uniform" Visibility="Collapsed" Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Content="Chọn ảnh đồng hồ" Click="PickImage_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,6,6"/>
                    <Button x:Name="BtnCrop" Content="Khoanh vùng số" Click="Crop_Click" IsEnabled="False"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,6,6"/>
                    <Button x:Name="BtnReadOcr" Content="Đọc số từ ảnh" Click="ReadOcr_Click" IsEnabled="False"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,6,6"/>
                    <Button x:Name="BtnUseSuggestion" Content="Dùng số gợi ý" Click="UseSuggestion_Click" IsEnabled="False"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,6,6"/>
                    <Button x:Name="BtnClearImage" Content="Bỏ ảnh" Click="ClearImage_Click" IsEnabled="False"
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock x:Name="TxtOcrStatus" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,6"
                           Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                <CheckBox x:Name="ChkConfirmed" Content="Tôi đã đối chiếu ảnh và xác nhận chỉ số mới"
                          IsEnabled="False" Margin="0,0,0,2"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="TxtError" Foreground="Red" FontSize="12"
                   TextWrapping="Wrap" Margin="0,8,0,4" Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" IsCancel="True" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button x:Name="BtnSave" Content="Thêm" Click="BtnOk_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>


