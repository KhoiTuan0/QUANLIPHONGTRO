<Window x:Class="QLPT.WPF.Views.Dialogs.ThongBaoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Gửi thông báo" Style="{StaticResource Win10Dialog}" Width="480"
        SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="24">
        <StackPanel>
            <TextBlock Text="Gửi thông báo" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBox x:Name="TxtTieuDe" MaxLength="200" md:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                     md:HintAssist.Hint="Tiêu đề *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,16"/>

            <TextBox x:Name="TxtNoiDung" MaxLength="1000"
                     md:HintAssist.Hint="Nội dung *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="100"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,16"/>

            <TextBlock Text="Loại *" Foreground="{DynamicResource Win11TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="CbLoai"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,0,16"
                      SelectedIndex="0">
                <ComboBoxItem Content="Hệ thống"/>
                <ComboBoxItem Content="Cá nhân"/>
            </ComboBox>

            <TextBox x:Name="TxtMaTaiKhoanNhan" MaxLength="200" md:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                     md:HintAssist.Hint="Mã tài khoản nhận (VD: 2, 5 — trống = gửi tất cả khách)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,16"/>

            <TextBlock x:Name="TxtError" Foreground="Crimson"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Hủy"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnSave" Content="Gửi"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>



