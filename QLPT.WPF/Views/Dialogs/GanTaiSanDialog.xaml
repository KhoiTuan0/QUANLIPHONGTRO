<Window x:Class="QLPT.WPF.Views.Dialogs.GanTaiSanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Gán tài sản vào phòng" Style="{StaticResource Win10Dialog}" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}"
        TextElement.FontFamily="{md:MaterialDesignFont}"
        TextElement.FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="28">
        <StackPanel>
            <TextBlock Text="Gán tài sản vào phòng" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource Win11TextPrimaryBrush}" Margin="0,0,0,20"/>

            <TextBlock x:Name="TxtInfo" Foreground="{DynamicResource Win11TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <TextBox x:Name="TxtSoLuong" MaxLength="5" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Số lượng *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" Text="1"/>
            <TextBox x:Name="TxtTinhTrang" MaxLength="100" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Tình trạng (VD: Tốt, Hỏng)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" Text="Tốt"/>

            <TextBlock x:Name="TxtError" Foreground="Crimson" TextWrapping="Wrap" Margin="0,4,0,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Hủy" Style="{StaticResource MaterialDesignFlatButton}"
                        Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnSave" Content="Gán" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>


