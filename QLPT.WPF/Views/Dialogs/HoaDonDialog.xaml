<Window x:Class="QLPT.WPF.Views.Dialogs.HoaDonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:svc="clr-namespace:QLPT.WPF.Services"
        Title="Tạo hóa đơn" Style="{StaticResource Win10Dialog}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Tạo hóa đơn" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource Win11TextPrimaryBrush}" Margin="0,0,0,16"/>

        <TextBox x:Name="TxtMaHopDong" MaxLength="9" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Mã hợp đồng *"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
        <TextBox x:Name="TxtThangNam" MaxLength="7" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Kỳ hóa đơn (yyyy-MM) *"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>

        <!-- Cách lập: tự động theo quy trình Ghi chỉ số → Tính tiền, hoặc nhập tay -->
        <RadioButton x:Name="RbTuDong" GroupName="Cach" IsChecked="True"
                     Content="Tự động từ chỉ số điện nước và dịch vụ đã đăng ký"
                     Checked="Cach_Changed" Margin="0,0,0,4"/>
        <TextBlock Text="Tiền phòng + điện, nước theo chỉ số đã ghi của kỳ + phí dịch vụ đang dùng."
                   FontSize="11" TextWrapping="Wrap" Margin="26,0,0,10"
                   Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
        <RadioButton x:Name="RbNhapTay" GroupName="Cach"
                     Content="Nhập tổng tiền thủ công"
                     Checked="Cach_Changed" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtTongTien" svc:MoneyInput.IsEnabled="True" md:HintAssist.Hint="Tổng tiền" IsEnabled="False"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="26,0,0,0"/>

        <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" IsCancel="True" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button Content="Tạo hóa đơn" Click="BtnOk_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
