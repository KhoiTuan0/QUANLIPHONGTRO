<Window x:Class="QLPT.WPF.Views.Dialogs.ThuChiDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:svc="clr-namespace:QLPT.WPF.Services"
        Title="Thêm thu chi" Style="{StaticResource Win10Dialog}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Thêm thu chi" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource Win11TextPrimaryBrush}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,0,0">
            <ComboBox x:Name="CbLoai" md:HintAssist.Hint="Loại *"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,10">
                <ComboBoxItem Content="Thu" IsSelected="True"/>
                <ComboBoxItem Content="Chi"/>
            </ComboBox>
            <TextBox x:Name="TxtSoTien" svc:MoneyInput.IsEnabled="True" md:HintAssist.Hint="Số tiền *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
            <TextBox x:Name="TxtMoTa" MaxLength="500" md:HintAssist.Hint="Mô tả *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <DatePicker x:Name="DpNgayGhiNhan" md:HintAssist.Hint="Ngày ghi nhận *"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,10"/>
            <TextBox x:Name="TxtMaHopDong" MaxLength="9" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Mã hợp đồng (tùy chọn)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
        </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="TxtError" Foreground="Red" FontSize="12"
                   TextWrapping="Wrap" Margin="0,8,0,4" Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" IsCancel="True" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button Content="Thêm" Click="BtnOk_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>


