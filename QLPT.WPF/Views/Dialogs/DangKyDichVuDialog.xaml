<Window x:Class="QLPT.WPF.Views.Dialogs.DangKyDichVuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:QLPT.WPF.Controls"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Đăng ký dịch vụ" Style="{StaticResource Win10Dialog}" Width="440"
        SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="24">
        <StackPanel>
            <TextBlock Text="Đăng ký dịch vụ" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

            <ctl:EntityPicker  x:Name="PickMaHopDong" Source="HopDongHieuLuc" Hint="Hợp đồng / Phòng *" SearchHint="Tìm phòng, tên khách hoặc mã hợp đồng" Margin="0,0,0,12"/>

            <ctl:EntityPicker  x:Name="PickMaDichVu" Source="DichVu" Hint="Dịch vụ *" SearchHint="Tìm tên dịch vụ hoặc mã" Margin="0,0,0,12"/>

            <DatePicker x:Name="DpNgayBatDau"
                        md:HintAssist.Hint="Ngày bắt đầu *"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Margin="0,0,0,16"/>

            <TextBlock x:Name="TxtError" Foreground="Crimson"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Hủy"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnSave" Content="Lưu"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>



