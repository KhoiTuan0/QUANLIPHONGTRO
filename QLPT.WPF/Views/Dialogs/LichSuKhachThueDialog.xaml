<Window x:Class="QLPT.WPF.Views.Dialogs.LichSuKhachThueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lịch sử sửa thông tin khách" Width="820" Height="490" MinWidth="650" MinHeight="350"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <DockPanel Margin="20">
        <TextBlock x:Name="TxtTitle" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Button DockPanel.Dock="Bottom" Content="Đóng" IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0"/>
        <TextBlock x:Name="TxtError" DockPanel.Dock="Bottom" Foreground="#EF4444" TextWrapping="Wrap"/>
        <DataGrid x:Name="GridHistory" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Thời điểm" Binding="{Binding NgaySua, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/>
                <DataGridTextColumn Header="Thông tin" Binding="{Binding Truong}" Width="120"/>
                <DataGridTextColumn Header="Giá trị cũ" Binding="{Binding GiaTriCu}" Width="*"/>
                <DataGridTextColumn Header="Giá trị mới" Binding="{Binding GiaTriMoi}" Width="*"/>
                <DataGridTextColumn Header="Tài khoản sửa" Binding="{Binding MaTaiKhoanSua}" Width="115"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
