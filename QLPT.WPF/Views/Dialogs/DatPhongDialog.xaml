<Window x:Class="QLPT.WPF.Views.Dialogs.DatPhongDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:QLPT.WPF.Controls"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:svc="clr-namespace:QLPT.WPF.Services"
        Title="Đặt phòng mới" Style="{StaticResource Win10Dialog}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}"
        >
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Đặt phòng / Giữ chỗ" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource Win11TextPrimaryBrush}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,0,0">
            <ctl:EntityPicker  x:Name="PickMaPhong" Source="PhongTrong" Hint="Phòng *" SearchHint="Tìm tên phòng, cơ sở hoặc mã" Margin="0,0,0,12"/>
            <Button Content="+ Thêm phòng mới" Click="AddRoom_Click" HorizontalAlignment="Left"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,0,8"/>
            <ctl:EntityPicker  x:Name="PickMaKhach" Source="KhachDatPhong" Hint="Khách thuê *" SearchHint="Tìm tên, CCCD, SĐT hoặc mã" Margin="0,0,0,12"/>
            <TextBlock Text="Khách đang thuê cơ sở khác có thể giữ chỗ; cần kết thúc lượt ở cũ trước khi nhận phòng."
                       FontSize="11" TextWrapping="Wrap" Margin="0,-6,0,10"
                       Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
            <Button Content="+ Thêm khách mới" Click="AddCustomer_Click" HorizontalAlignment="Left"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtTienCoc" svc:MoneyInput.IsEnabled="True" md:HintAssist.Hint="Tiền cọc *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
        </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="TxtError" Foreground="Red" FontSize="12"
                   TextWrapping="Wrap" Margin="0,8,0,4" Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" IsCancel="True" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button Content="Đặt phòng" Click="BtnOk_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>


