<Window x:Class="QLPT.WPF.Views.Dialogs.ChonBanGiaoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn biên bản" Width="480" Height="280"
        MinWidth="430" MinHeight="250" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Chọn biên bản đã lưu để xuất" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <ListBox Grid.Row="1" x:Name="ListRecords" DisplayMemberPath="Label"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" Width="76" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Xuất biên bản" MinWidth="120" Click="Export_Click"/>
        </StackPanel>
    </Grid>
</Window>
