<Window x:Class="QLPT.WPF.Views.Dialogs.PhongDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:QLPT.WPF.Controls"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:svc="clr-namespace:QLPT.WPF.Services"
        Title="Phòng" Style="{StaticResource Win10Dialog}" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}"
        TextElement.FontFamily="{md:MaterialDesignFont}"
        TextElement.FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="28">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="Thêm phòng" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource Win11TextPrimaryBrush}" Margin="0,0,0,20"/>

            <TextBlock x:Name="TxtHistoryNotice" Visibility="Collapsed" TextWrapping="Wrap"
                       Foreground="{DynamicResource Win11TextSecondaryBrush}" Margin="0,0,0,14"
                       Text="Phòng đã từng có hợp đồng hoặc phiếu đặt. Tên, loại phòng, cơ sở và tầng được giữ cố định để bảo toàn lịch sử; bạn vẫn có thể sửa giá thuê, trạng thái hợp lệ và mô tả."/>

            <TextBox x:Name="TxtTenPhong" MaxLength="50" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Tên phòng *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ctl:EntityPicker Grid.Column="0" x:Name="PickMaLoaiPhong" Source="LoaiPhong" Hint="Loại phòng *" SearchHint="Tìm tên loại phòng hoặc mã" Margin="0,0,0,12"/>
                <ctl:EntityPicker Grid.Column="2" x:Name="PickMaCoSo" Source="CoSo" Hint="Cơ sở *" SearchHint="Tìm tên cơ sở hoặc mã" Margin="0,0,0,12"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtGiaThue" svc:MoneyInput.IsEnabled="True" md:HintAssist.Hint="Giá thuê (từ 100.000 đ) *"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                <TextBox Grid.Column="2" x:Name="TxtTang" MaxLength="3" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Tầng *"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            </Grid>

            <ComboBox x:Name="CboTrangThai" md:HintAssist.Hint="Trạng thái"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,0,12">
                <ComboBoxItem Content="Trống"/>
                <ComboBoxItem Content="Đã đặt cọc"/>
                <ComboBoxItem Content="Đang thuê"/>
                <ComboBoxItem Content="Bảo trì"/>
            </ComboBox>

            <TextBox x:Name="TxtMoTa" MaxLength="300" md:HintAssist.Hint="Mô tả"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

            <TextBlock x:Name="TxtError" Foreground="Crimson" TextWrapping="Wrap" Margin="0,4,0,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Hủy" Style="{StaticResource MaterialDesignFlatButton}"
                        Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnSave" Content="Lưu" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>


