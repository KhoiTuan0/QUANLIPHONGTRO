<Window x:Class="QLPT.WPF.Views.Dialogs.MeterNumberCropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn vùng số công tơ" Width="800" Height="720" MinWidth="520" MinHeight="450"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Kéo chuột khoanh sát dãy số màu đen (kWh). Bỏ ô số đỏ 1/10 kWh."
                       TextWrapping="Wrap" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Số ô chữ số đen:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="DigitCountBox" Width="65" SelectedIndex="1">
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                    <ComboBoxItem Content="7"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="CropCanvas" Background="Transparent"
                    MouseLeftButtonDown="CropCanvas_MouseLeftButtonDown"
                    MouseMove="CropCanvas_MouseMove"
                    MouseLeftButtonUp="CropCanvas_MouseLeftButtonUp">
                <Image x:Name="FullImage" Stretch="Fill" IsHitTestVisible="False"/>
                <Rectangle x:Name="Selection" Visibility="Collapsed" IsHitTestVisible="False"
                           Stroke="#2196F3" StrokeThickness="2" Fill="#442196F3"/>
            </Canvas>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="Hint" Foreground="Red" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Hủy" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Dùng vùng đã chọn" Click="Confirm_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
