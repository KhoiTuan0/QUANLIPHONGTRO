<Window x:Class="QLPT.WPF.Views.Dialogs.GanPhatHoaDonDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Đưa tiền phạt vào hóa đơn" Width="720" Height="520" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource Win11SurfaceBrush}" TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="TxtInfo" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <DataGrid Grid.Row="1" x:Name="GridInvoices" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Mã hóa đơn" Binding="{Binding MaHoaDon}" Width="100"/>
    <DataGridTextColumn Header="Kỳ" Binding="{Binding Ky}" Width="100"/>
    <DataGridTextColumn Header="Tổng hiện tại" Binding="{Binding TongDisplay}" Width="*"/>
    <DataGridTextColumn Header="Tổng sau thêm phạt" Binding="{Binding SauDisplay}" Width="*"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="2" x:Name="TxtError" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,12"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Đóng" IsCancel="True" Margin="0,0,12,0"/>
   <Button Content="Đưa vào hóa đơn" Click="Save_Click"/>
  </StackPanel>
 </Grid>
</Window>
