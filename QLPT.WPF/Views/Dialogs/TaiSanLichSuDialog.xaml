<Window x:Class="QLPT.WPF.Views.Dialogs.TaiSanLichSuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:svc="clr-namespace:QLPT.WPF.Services"
        Title="Lịch sử hiện vật" Style="{StaticResource Win10Dialog}" Width="650" Height="680"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" MinWidth="570" MinHeight="530"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}"
        TextElement.FontFamily="{md:MaterialDesignFont}" TextElement.FontSize="14">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtTitle" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <DataGrid x:Name="GridHistory" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserSortColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ngày" Binding="{Binding Ngay}" Width="120"/>
                    <DataGridTextColumn Header="Sự kiện" Binding="{Binding Loai}" Width="105"/>
                    <DataGridTextColumn Header="Chi phí" Binding="{Binding ChiPhi}" Width="110"/>
                    <DataGridTextColumn Header="Nội dung" Binding="{Binding NoiDung}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="TxtHistoryEmpty" Text="Hiện vật này chưa có sự kiện lịch sử. Lưu kiểm kê hoặc ghi nhận sửa chữa ở bên dưới để bắt đầu theo dõi."
                       Visibility="Collapsed" IsHitTestVisible="False" TextAlignment="Center" TextWrapping="Wrap"
                       VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="430" Margin="16"
                       Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Kiểm kê hiện vật" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtPurchaseHelp" Text="Ngày mua và giá mua là thông tin mua ban đầu; chi phí sửa chữa, bảo dưỡng được ghi riêng bên dưới."
                       TextWrapping="Wrap" Foreground="{DynamicResource Win11TextSecondaryBrush}" FontSize="12"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="TxtTinhTrang" Width="175" MaxLength="100" md:HintAssist.Hint="Tình trạng *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0"/>
            <DatePicker x:Name="DpNgayMua" Width="155" Margin="0,0,8,0" Language="vi-VN" md:HintAssist.Hint="Ngày mua"/>
            <TextBox x:Name="TxtGiaMua" Width="105" svc:MoneyInput.IsEnabled="True" md:HintAssist.Hint="Giá mua"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
        </StackPanel>
        <Button Grid.Row="4" x:Name="BtnInventory" Content="Lưu kiểm kê" Click="Inventory_Click"
                HorizontalAlignment="Right" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,10"/>
        <TextBlock x:Name="TxtEventHeading" Grid.Row="5" Text="Ghi nhận sửa chữa, bảo dưỡng hoặc thanh lý" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox x:Name="CbLoai" Width="180" SelectedIndex="0" Margin="0,0,10,0"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}">
                <ComboBoxItem Content="Sửa chữa"/>
                <ComboBoxItem Content="Bảo dưỡng"/>
                <ComboBoxItem Content="Kiểm kê"/>
                <ComboBoxItem Content="Thanh lý"/>
            </ComboBox>
            <DatePicker x:Name="DpNgay" Width="180" Language="vi-VN"/>
        </StackPanel>
        <TextBox x:Name="TxtChiPhi" Grid.Row="7" svc:MoneyInput.IsEnabled="True"
                 md:HintAssist.Hint="Chi phí (đ)" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Text="0" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtNoiDung" Grid.Row="8" MaxLength="500" AcceptsReturn="True" Height="76"
                 md:HintAssist.Hint="Nội dung *" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock x:Name="TxtError" Grid.Row="9" Foreground="Crimson" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Đóng" Click="Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
            <Button x:Name="BtnSave" Content="Ghi nhận" Click="Save_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
