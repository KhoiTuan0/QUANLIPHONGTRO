<Window x:Class="QLPT.WPF.Views.Dialogs.ThanhLyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:svc="clr-namespace:QLPT.WPF.Services"
        Title="Thanh lý hợp đồng" Style="{StaticResource Win10Dialog}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Thanh lý hợp đồng" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource Win11TextPrimaryBrush}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" x:Name="TxtInfo" FontSize="13" Foreground="{DynamicResource Win11TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,0,0">
            <TextBox x:Name="TxtTienHoanCoc" svc:MoneyInput.IsEnabled="True" md:HintAssist.Hint="Tiền cọc đem quyết toán * (mặc định = toàn bộ cọc)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
            <TextBox x:Name="TxtTienNo" svc:MoneyInput.IsEnabled="True" md:HintAssist.Hint="Tiền nợ - đã tự động tính"
                     IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
            <TextBox x:Name="TxtTienPhat" svc:MoneyInput.IsEnabled="True" md:HintAssist.Hint="Tiền phạt"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
            <TextBox x:Name="TxtGhiChu" MaxLength="300" md:HintAssist.Hint="Ghi chú"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
        </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="TxtError" Foreground="Red" FontSize="12"
                   TextWrapping="Wrap" Margin="0,8,0,4" Visibility="Collapsed"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" IsCancel="True" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button Content="Xác nhận thanh lý" Click="BtnOk_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="OrangeRed" BorderBrush="OrangeRed" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>


