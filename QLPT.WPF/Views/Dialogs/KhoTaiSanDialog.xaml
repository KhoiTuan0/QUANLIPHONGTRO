<Window x:Class="QLPT.WPF.Views.Dialogs.KhoTaiSanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Kho tài sản" Style="{StaticResource Win10Dialog}" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}"
        TextElement.FontFamily="{md:MaterialDesignFont}" TextElement.FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="28">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock x:Name="TxtInfo" Foreground="{DynamicResource Win11TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,16"/>
                <TextBox x:Name="TxtSoLuong" MaxLength="3" Text="1" Margin="0,0,0,12"
                         md:HintAssist.Hint="Số lượng *" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                <StackPanel x:Name="PurchaseFields">
                    <DatePicker x:Name="PickNgayMua" Margin="0,0,0,12" md:HintAssist.Hint="Ngày mua (nếu biết)"/>
                    <TextBox x:Name="TxtGiaMua" Margin="0,0,0,12" MaxLength="20"
                             md:HintAssist.Hint="Giá mua mỗi chiếc (đ, nếu biết)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    <TextBox x:Name="TxtTinhTrang" Text="Tốt" MaxLength="100" Margin="0,0,0,12"
                             md:HintAssist.Hint="Tình trạng *" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    <TextBox x:Name="TxtGhiChu" MaxLength="500" Margin="0,0,0,12"
                             md:HintAssist.Hint="Ghi chú lô hàng" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </StackPanel>
                <TextBlock x:Name="TxtError" Foreground="Crimson" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy" Click="Cancel_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSave" Content="Lưu" Click="Save_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
