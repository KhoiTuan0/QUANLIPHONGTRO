<Window x:Class="QLPT.WPF.Views.Dialogs.KhaiBaoCuTruDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Xem khai báo cư trú" Style="{StaticResource Win10Dialog}"
        Width="520" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Thông tin khách gửi" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
            <TextBlock x:Name="TxtTenant" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtDates" Margin="0,6,0,16" TextWrapping="Wrap"
                       Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
            <TextBlock Text="Địa chỉ thường trú" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtAddress" Margin="0,4,0,12" TextWrapping="Wrap"/>
            <TextBlock Text="Thông tin bổ sung" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtDetails" Margin="0,4,0,16" TextWrapping="Wrap"/>
            <TextBox x:Name="TxtReason" MaxLength="300" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="76" md:HintAssist.Hint="Lý do trả lại nếu cần bổ sung"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            <TextBlock x:Name="TxtError" Foreground="Crimson" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Đóng" IsCancel="True" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                <Button Content="Trả lại" Click="BtnReject_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                <Button Content="Xác nhận" Click="BtnApprove_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
