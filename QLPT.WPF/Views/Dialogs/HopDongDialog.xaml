<Window x:Class="QLPT.WPF.Views.Dialogs.HopDongDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:QLPT.WPF.Controls"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:svc="clr-namespace:QLPT.WPF.Services"
        Title="Tạo hợp đồng mới" Style="{StaticResource Win10Dialog}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtHeading" Text="Tạo hợp đồng" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource Win11TextPrimaryBrush}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,0,0">
            <ctl:EntityPicker  x:Name="PickMaPhong" Source="PhongTrong" Hint="Phòng *" SearchHint="Tìm tên phòng, cơ sở hoặc mã" Margin="0,0,0,12"/>
            <Button x:Name="BtnAddRoom" Content="+ Thêm phòng mới" Click="AddRoom_Click" HorizontalAlignment="Left"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,0,8"/>
            <ctl:EntityPicker  x:Name="PickMaKhachDaiDien" Source="KhachThue" Hint="Người đứng tên hợp đồng *" SearchHint="Tìm tên, CCCD, SĐT hoặc mã" Margin="0,0,0,12"/>
            <Button x:Name="BtnAddCustomer" Content="+ Thêm khách mới" Click="AddCustomer_Click" HorizontalAlignment="Left"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,0,8"/>
            <TextBlock Text="Người thực tế ở phòng (có thể khác người đứng tên hợp đồng)" TextWrapping="Wrap" Margin="0,4,0,6"/>
            <ctl:EntityPicker x:Name="PickMaKhachCuTru" Source="KhachThue" Hint="Người ở thực tế *" SearchHint="Tìm tên, CCCD, SĐT hoặc mã" Margin="0,0,0,12"/>
            <Button Content="+ Thêm hồ sơ người ở" Click="AddOccupant_Click" HorizontalAlignment="Left"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,0,8"/>
            <DatePicker x:Name="DpNgayBatDau" md:HintAssist.Hint="Ngày bắt đầu *"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,12"/>
            <DatePicker x:Name="DpNgayKetThuc" md:HintAssist.Hint="Ngày kết thúc *"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,12"/>
            <TextBox x:Name="TxtGiaThueThang" svc:MoneyInput.IsEnabled="True" md:HintAssist.Hint="Giá thuê/tháng *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
            <TextBox x:Name="TxtTienCoc" svc:MoneyInput.IsEnabled="True" md:HintAssist.Hint="Tiền cọc *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
        </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="TxtError" Foreground="Red" FontSize="12"
                   TextWrapping="Wrap" Margin="0,8,0,4" Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" IsCancel="True" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button Content="Tạo hợp đồng" Click="BtnOk_Click" IsDefault="True"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>


