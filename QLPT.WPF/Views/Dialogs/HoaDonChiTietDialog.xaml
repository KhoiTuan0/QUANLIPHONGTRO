<Window x:Class="QLPT.WPF.Views.Dialogs.HoaDonChiTietDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết hóa đơn" Style="{StaticResource Win10Dialog}"
        Width="760" Height="570" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Chi tiết hóa đơn" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtThongTin" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtNgay" Margin="0,4,0,0" Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Các khoản tính" FontWeight="SemiBold" Margin="0,20,0,8"/>
        <DataGrid Grid.Row="2" x:Name="GridChiTiet" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nội dung" Binding="{Binding NoiDung}" Width="2*"/>
                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="*"/>
                <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia}" Width="*"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Đóng" IsCancel="True" Width="90"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <StackPanel>
                <TextBlock x:Name="TxtTong" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtThanhToan" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
