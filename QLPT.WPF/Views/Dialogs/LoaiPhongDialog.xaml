<Window x:Class="QLPT.WPF.Views.Dialogs.LoaiPhongDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:svc="clr-namespace:QLPT.WPF.Services"
        Title="Loại phòng" Style="{StaticResource Win10Dialog}" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}"
        TextElement.FontFamily="{md:MaterialDesignFont}"
        TextElement.FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="28">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="Thêm loại phòng" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource Win11TextPrimaryBrush}" Margin="0,0,0,20"/>

            <TextBox x:Name="TxtTen" MaxLength="100" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Tên loại phòng *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
            <TextBox x:Name="TxtDienTich" MaxLength="7" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Diện tích (m²)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
            <TextBox x:Name="TxtSoNguoi" MaxLength="2" md:TextFieldAssist.CharacterCounterVisibility="Collapsed" md:HintAssist.Hint="Số người tối đa *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
            <TextBox x:Name="TxtGia" svc:MoneyInput.IsEnabled="True" md:HintAssist.Hint="Giá mặc định"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
            <TextBox x:Name="TxtMoTa" MaxLength="300" md:HintAssist.Hint="Mô tả"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

            <TextBlock x:Name="TxtError" Foreground="Crimson" TextWrapping="Wrap" Margin="0,4,0,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Hủy" Style="{StaticResource MaterialDesignFlatButton}"
                        Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnSave" Content="Lưu" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>


