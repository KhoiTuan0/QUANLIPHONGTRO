<Window x:Class="QLPT.WPF.Views.Dialogs.PhanHoiDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Phản hồi thông báo" Style="{StaticResource Win10Dialog}" Width="480"
        SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" MaxHeight="700"
        Background="{DynamicResource Win11SurfaceBrush}"
        TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="24">
            <StackPanel>
                <TextBlock Text="Phản hồi chủ trọ" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                <!-- Thông báo gốc đang trả lời -->
                <Border Background="{DynamicResource Win11ContentBrush}"
                        BorderBrush="{DynamicResource Win11BorderBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="12,9" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="TxtTieuDe" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtNoiDungGoc" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   MaxHeight="90" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <TextBox x:Name="TxtNoiDung"
                         md:HintAssist.Hint="Nội dung phản hồi *"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                         VerticalScrollBarVisibility="Auto" MaxLength="1000"
                         Margin="0,0,0,12"/>

                <TextBlock x:Name="TxtError" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy" IsCancel="True"
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSend" Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="BtnSend_Click">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Send" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Gửi phản hồi" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
