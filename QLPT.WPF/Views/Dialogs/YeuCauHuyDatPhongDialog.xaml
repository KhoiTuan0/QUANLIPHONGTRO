<Window x:Class="QLPT.WPF.Views.Dialogs.YeuCauHuyDatPhongDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 xmlns:svc="clr-namespace:QLPT.WPF.Services"
 Title="Yêu cầu hủy đặt phòng" Width="960" Height="730" MinWidth="680" MinHeight="500"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource Win11SurfaceBrush}"
 TextElement.Foreground="{DynamicResource Win11TextPrimaryBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Tải lại" Click="Reload_Click"/>
   <TextBlock Text="Yêu cầu hủy đặt phòng" FontSize="20" FontWeight="SemiBold"/></DockPanel>
  <TextBlock Text="Chọn yêu cầu để xem và xử lý. Gửi yêu cầu chưa hủy phòng; duyệt sẽ hủy giữ chỗ và ghi hoàn cọc một lần." TextWrapping="Wrap" Margin="0,0,0,12"/>
  <DataGrid x:Name="GridRequests" Height="235" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="SelectionChanged">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Mã YC" Binding="{Binding MaYeuCau}" Width="65"/>
    <DataGridTextColumn Header="Đặt phòng" Binding="{Binding MaDatPhong}" Width="85"/>
    <DataGridTextColumn Header="Phòng" Binding="{Binding TenPhong}" Width="90"/>
    <DataGridTextColumn Header="Khách" Binding="{Binding TenKhach}" Width="160"/>
    <DataGridTextColumn Header="Ngày gửi" Binding="{Binding NgayYeuCau, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
    <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="110"/>
    <DataGridTextColumn Header="Hoàn cọc" Binding="{Binding HoanDisplay}" Width="120"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock x:Name="TxtDetail" Text="Chưa chọn yêu cầu." TextWrapping="Wrap" Margin="0,12"/>
  <TextBox x:Name="TxtRefund" svc:MoneyInput.IsEnabled="True" md:HintAssist.Hint="Số tiền hoàn khi duyệt (nhập 0 nếu không hoàn)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
  <TextBox x:Name="TxtDecision" md:HintAssist.Hint="Lý do quyết định / thỏa thuận hoàn cọc *" Style="{StaticResource MaterialDesignOutlinedTextBox}" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" Margin="0,0,0,16"/>
  <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,10">
   <Button Content="Từ chối yêu cầu" Click="Reject_Click" Margin="0,0,12,0"/>
   <Button Content="Duyệt hủy và hoàn cọc" Click="Approve_Click"/>
  </WrapPanel>
  <Border BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
   <StackPanel><TextBlock x:Name="TxtBooking" TextWrapping="Wrap"/>
    <TextBox x:Name="TxtReason" md:HintAssist.Hint="Lý do khách yêu cầu hủy *" Style="{StaticResource MaterialDesignOutlinedTextBox}" MaxLength="500" Margin="0,10,0,22"/>
    <Button x:Name="BtnCreate" Content="Tiếp nhận yêu cầu cho phiếu đã chọn" Click="Create_Click" HorizontalAlignment="Right"/>
   </StackPanel>
  </Border>
  <TextBlock x:Name="TxtError" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,12"/>
  <Button Content="Đóng" IsCancel="True" HorizontalAlignment="Right"/>
 </StackPanel></ScrollViewer>
</Window>
