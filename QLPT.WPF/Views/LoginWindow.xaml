<Window x:Class="QLPT.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:QLPT.WPF.ViewModels"
        Title="Đăng nhập — Quản lý phòng trọ"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        FontSize="14">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <Border Grid.Column="0" Background="{DynamicResource Win11AccentBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                <md:PackIcon Kind="HomeCity" Width="72" Height="72"
                             Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,28"/>
                <TextBlock Text="HỆ THỐNG QUẢN LÝ" FontSize="24" FontWeight="Bold"
                           Foreground="White" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="CHO THUÊ PHÒNG TRỌ" FontSize="24" FontWeight="Bold"
                           Foreground="White" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="KLCN052" FontSize="16" Foreground="#BFDFFF"
                           TextAlignment="Center" Margin="0,10,0,0"/>
                <Rectangle Height="1" Fill="#40FFFFFF" Margin="40,24"/>
                <TextBlock Text="Quản lý phòng trọ thông minh, hiện đại"
                           FontSize="13" Foreground="#BFDFFF" TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Right panel — login form -->
        <Border Grid.Column="1" Background="{DynamicResource Win11SurfaceBrush}" Padding="40,48">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Đăng nhập" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource Win11TextPrimaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Vui lòng đăng nhập để tiếp tục"
                               Foreground="{DynamicResource Win11TextSecondaryBrush}"
                               FontSize="13" Margin="0,0,0,32"/>

                    <!-- Hidden API URL — kept for code-behind compatibility -->
                    <TextBox x:Name="TxtApiUrl" Visibility="Collapsed" Text="http://localhost:5000"/>

                    <!-- Username -->
                    <TextBox x:Name="TxtUsername"
                             md:HintAssist.Hint="Tên đăng nhập"
                             md:TextFieldAssist.HasLeadingIcon="True"
                             md:TextFieldAssist.LeadingIcon="Account"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,16"/>

                    <!-- Password -->
                    <PasswordBox x:Name="PbPassword"
                                 md:HintAssist.Hint="Mật khẩu"
                                 md:TextFieldAssist.HasLeadingIcon="True"
                                 md:TextFieldAssist.LeadingIcon="Lock"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 Margin="0,0,0,8"/>

                    <!-- Error message -->
                    <TextBlock x:Name="TxtStatus"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="#CC0000"
                               Margin="0,4,0,12" MinHeight="20"/>

                    <!-- Login button -->
                    <Button x:Name="BtnLogin"
                            Content="ĐĂNG NHẬP"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="48" FontSize="15" FontWeight="Bold"
                            Click="BtnLogin_Click" Margin="0,0,0,12"/>

                    <!-- Register -->
                    <Button x:Name="BtnRegister"
                            Content="Chưa có tài khoản? Đăng ký ngay"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource Win11TextSecondaryBrush}"
                            Click="BtnRegister_Click"/>

                    <!-- Loading indicator -->
                    <ProgressBar x:Name="LoadingBar"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}"
                                 IsIndeterminate="True" Margin="0,16,0,0"
                                 Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
