<UserControl x:Class="QLPT.WPF.Views.Pages.SaoLuuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ctl="clr-namespace:QLPT.WPF.Controls"
             xmlns:vm="clr-namespace:QLPT.WPF.ViewModels">
    <UserControl.DataContext>
        <vm:SaoLuuViewModel/>
    </UserControl.DataContext>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Thông báo thân thiện khi API chưa hỗ trợ sao lưu -->
        <Border Grid.Row="0" Background="{DynamicResource Win11AccentLightBrush}"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding InfoMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="Information" Width="20" Height="20"
                             Foreground="{DynamicResource Win11TextPrimaryBrush}"
                             VerticalAlignment="Center"/>
                <TextBlock Text="{Binding InfoMessage}"
                           Foreground="{DynamicResource Win11TextPrimaryBrush}"
                           FontSize="13" Margin="8,0,0,0"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ctl:CrudTable Grid.Row="1"
                       ItemsSource="{Binding Items}"
                       SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                       ReloadCommand="{Binding LoadCommand}"
                       AddCommand="{Binding TaoSaoLuuCommand}"
                       DeleteCommand="{Binding XoaCommand}"
                       IsBusy="{Binding IsBusy}"
                       ErrorMessage="{Binding ErrorMessage}"
                       AddLabel="Tạo bản sao lưu"
                       AddIcon="DatabaseExport"
                       DeleteLabel="Xóa bản sao lưu này"
                       ShowEdit="False"
                       SearchHint="Tìm theo tên tệp, ngày tạo…">

            <ctl:CrudTable.Columns>
                <DataGridTextColumn Header="ID"         Binding="{Binding Id}"        Width="0.8*" MinWidth="80"/>
                <DataGridTextColumn Header="TÊN TỆP"    Binding="{Binding FileName}"  Width="*"/>
                <DataGridTextColumn Header="NGÀY TẠO"   Binding="{Binding NgayTao}"   Width="1.8*" MinWidth="180"/>
                <DataGridTextColumn Header="KÍCH THƯỚC" Binding="{Binding KichThuoc}" Width="1.2*" MinWidth="120"/>
            </ctl:CrudTable.Columns>
        </ctl:CrudTable>
    </Grid>
</UserControl>
