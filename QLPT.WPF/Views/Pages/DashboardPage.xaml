<UserControl x:Class="QLPT.WPF.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:QLPT.WPF.ViewModels">

    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Ẩn khi có dữ liệu, hiện thông báo khi trống -->
        <Style x:Key="KhiTrong" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Win11TextSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CoDoanhThu}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Tổng quan hệ thống"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource Win11TextPrimaryBrush}"/>
                <TextBlock Text="Dữ liệu thời gian thực từ hệ thống quản lý phòng trọ"
                           FontSize="12" Margin="0,3,0,0"
                           Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Command="{Binding LoadCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Height="32" Padding="12,0">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Tải lại" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- ── Row 1: Phòng & Khách (4 cards) ── -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,10">

            <!-- Tổng phòng -->
            <Border Margin="0,0,10,0" Background="{DynamicResource Win11SurfaceBrush}"
                    BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#3B82F6"/>
                    <StackPanel Grid.Column="1" Margin="16,14,16,14">
                        <TextBlock Text="{Binding TongPhong}" FontSize="34" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Win11TextPrimaryBrush}" LineHeight="38"/>
                        <TextBlock Text="Tổng phòng" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Phòng trống -->
            <Border Margin="0,0,10,0" Background="{DynamicResource Win11SurfaceBrush}"
                    BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#22C55E"/>
                    <StackPanel Grid.Column="1" Margin="16,14,16,14">
                        <TextBlock Text="{Binding PhongTrong}" FontSize="34" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Win11TextPrimaryBrush}" LineHeight="38"/>
                        <TextBlock Text="Phòng trống" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Đang thuê -->
            <Border Margin="0,0,10,0" Background="{DynamicResource Win11SurfaceBrush}"
                    BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#A855F7"/>
                    <StackPanel Grid.Column="1" Margin="16,14,16,14">
                        <TextBlock Text="{Binding DangThue}" FontSize="34" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Win11TextPrimaryBrush}" LineHeight="38"/>
                        <TextBlock Text="Đang thuê" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Khách đang ở: người đang thực sự sống trong phòng (không tính khách cũ / mới đặt cọc) -->
            <Border Background="{DynamicResource Win11SurfaceBrush}"
                    BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="1"
                    ToolTip="Người đang ở hoặc tạm vắng thuộc hợp đồng còn hiệu lực. Không tính khách đã trả phòng hay mới đặt cọc.">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F97316"/>
                    <StackPanel Grid.Column="1" Margin="16,14,16,14">
                        <TextBlock Text="{Binding KhachDangO}" FontSize="34" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Win11TextPrimaryBrush}" LineHeight="38"/>
                        <TextBlock FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Win11TextSecondaryBrush}">
                            <Run Text="Khách đang ở"/><Run Text="{Binding TongKhach, StringFormat=' · {0} hồ sơ', Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ── Row 2: Hợp đồng & Tài chính (4 cards) ── -->
        <UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="0,0,0,20">

            <!-- HĐ hiệu lực -->
            <Border Margin="0,0,10,0" Background="{DynamicResource Win11SurfaceBrush}"
                    BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#06B6D4"/>
                    <StackPanel Grid.Column="1" Margin="16,14,16,14">
                        <TextBlock Text="{Binding HdHieuLuc}" FontSize="34" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Win11TextPrimaryBrush}" LineHeight="38"/>
                        <TextBlock Text="Hợp đồng hiệu lực" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sắp hết hạn -->
            <Border Margin="0,0,10,0" Background="{DynamicResource Win11SurfaceBrush}"
                    BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F59E0B"/>
                    <StackPanel Grid.Column="1" Margin="16,14,16,14">
                        <TextBlock Text="{Binding SapHetHan}" FontSize="34" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Win11TextPrimaryBrush}" LineHeight="38"/>
                        <TextBlock Text="Sắp hết hạn" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Công nợ -->
            <Border Margin="0,0,10,0" Background="{DynamicResource Win11SurfaceBrush}"
                    BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#EF4444"/>
                    <StackPanel Grid.Column="1" Margin="16,14,16,14">
                        <TextBlock Text="{Binding CongNo}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Win11TextPrimaryBrush}"
                                   TextWrapping="Wrap" LineHeight="24"/>
                        <TextBlock Text="Công nợ chưa thu" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Doanh thu -->
            <Border Background="{DynamicResource Win11SurfaceBrush}"
                    BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#16A34A"/>
                    <StackPanel Grid.Column="1" Margin="16,14,16,14">
                        <TextBlock Text="{Binding DoanhThu}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Win11TextPrimaryBrush}"
                                   TextWrapping="Wrap" LineHeight="24"/>
                        <TextBlock Text="Doanh thu tháng này" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ── Biểu đồ ── -->
        <Grid Grid.Row="3" Height="300" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Doanh thu theo kỳ: cột chồng Đã thu + Còn nợ -->
            <Border Grid.Column="0" Background="{DynamicResource Win11SurfaceBrush}"
                    BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="1" Padding="20,16,12,10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,8,6" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Doanh thu theo kỳ hóa đơn" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource Win11TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding TyLeThuKyGanNhat}" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                        </StackPanel>
                        <!-- Chú thích: ô màu giống hình cột, chữ dùng màu chữ (không tô màu series) -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource ChartSeries1Brush}"/>
                            <TextBlock Text="Đã thu" FontSize="12" Margin="6,0,14,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                            <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource ChartSeries2Brush}"/>
                            <TextBlock Text="Còn nợ" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <ComboBox Width="106" Height="28" ItemsSource="{Binding KhoangOptions}"
                                  SelectedItem="{Binding KhoangThoiGian}" ToolTip="Chọn số tháng thống kê doanh thu"/>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding KhoangThoiGian}" Value="Tùy chọn">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <DatePicker Width="112" SelectedDate="{Binding NgayTu}" ToolTip="Từ tháng"/>
                            <TextBlock Text="đến" Margin="5,0" VerticalAlignment="Center"/>
                            <DatePicker Width="112" SelectedDate="{Binding NgayDen}" ToolTip="Đến tháng"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Crimson" Margin="8,0,0,0"
                                   VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                    <Grid>
                        <lvc:CartesianChart Series="{Binding DoanhThuSeries}"
                                            Background="{DynamicResource Win11SurfaceBrush}"
                                            XAxes="{Binding DoanhThuX}"
                                            YAxes="{Binding DoanhThuY}"
                                            LegendPosition="Hidden"
                                            TooltipPosition="Top"
                                            TooltipBackgroundPaint="{Binding TooltipNen}"
                                            TooltipTextPaint="{Binding TooltipChu}"
                                            TooltipTextSize="12"
                                            ZoomMode="None"/>
                        <TextBlock Text="Chưa có hóa đơn nào" Style="{StaticResource KhiTrong}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Tình trạng phòng: donut + chú thích có số lượng -->
            <Border Grid.Column="2" Background="{DynamicResource Win11SurfaceBrush}"
                    BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="1" Padding="20,16,20,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Tình trạng phòng" FontWeight="SemiBold" FontSize="13"
                               Margin="0,0,0,6" Foreground="{DynamicResource Win11TextPrimaryBrush}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <lvc:PieChart Series="{Binding PhongSeries}"
                                          Background="{DynamicResource Win11SurfaceBrush}"
                                          LegendPosition="Hidden"
                                          InitialRotation="-90"
                                          TooltipPosition="Hidden"
                                          HoveredPointsChanged="PhongChart_HoveredPointsChanged"
                                          MouseLeave="PhongChart_MouseLeave"
                                          TooltipBackgroundPaint="{Binding TooltipNen}"
                                          TooltipTextPaint="{Binding TooltipChu}"
                                          TooltipTextSize="12"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="{Binding TongSoPhong}" FontSize="26" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Win11TextPrimaryBrush}"/>
                                <TextBlock Text="phòng" FontSize="11" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                        <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding PhongChuThich}"
                                      VerticalAlignment="Center" Margin="8,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto" MinWidth="78"/>
                                            <ColumnDefinition Width="Auto" MinWidth="22"/>
                                            <ColumnDefinition Width="Auto" MinWidth="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                                Background="{Binding Mau}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Ten}" FontSize="12" Margin="8,0,8,0"
                                                   Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding GiaTri}" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource Win11TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TyLe}" FontSize="11" Margin="6,0,0,0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Padding="4,4"
                                BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="0,1,0,0">
                            <TextBlock Text="{Binding PhongDangRe}" HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" FontSize="11"
                                       Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ── Contracts table ── -->
        <Border Grid.Row="4" Background="{DynamicResource Win11SurfaceBrush}"
                BorderBrush="{DynamicResource Win11BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,12"
                        BorderBrush="{DynamicResource Win11BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Hợp đồng sắp hoặc đã hết hạn"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource Win11TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding MoTaHetHan}"
                                       FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Xem trong" VerticalAlignment="Center" Margin="0,0,8,0"
                                       FontSize="11" Foreground="{DynamicResource Win11TextSecondaryBrush}"/>
                            <ComboBox Width="102" Height="32" ItemsSource="{Binding HetHanOptions}"
                                      SelectedItem="{Binding MocHetHan, Mode=TwoWay}"
                                      HorizontalContentAlignment="Center" ToolTip="Chọn mốc hợp đồng sắp hết hạn"/>
                            <TextBox Width="58" Height="32" Margin="8,0,0,0" MaxLength="3"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     Text="{Binding SoNgayTuyChon, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                     Visibility="{Binding HienSoNgayTuyChon, Converter={StaticResource BoolToVis}}"
                                     ToolTip="Nhập số ngày từ 1 đến 365"/>
                            <TextBlock Text="ngày" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="11"
                                       Visibility="{Binding HienSoNgayTuyChon, Converter={StaticResource BoolToVis}}"/>
                            <Border Background="#FEF3C7" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SapHetHan, StringFormat='{}{0} hợp đồng'}"
                                           FontSize="11" FontWeight="Medium" Foreground="#92400E"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <DataGrid ItemsSource="{Binding HopDongSapHetHan}" MinHeight="140"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" BorderThickness="0"
                          
                          RowStyle="{StaticResource AppDataGridRow}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource Win11TextSecondaryBrush}"/>
                            <Setter Property="Padding" Value="16,10"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MÃ HĐ" Binding="{Binding MaHopDong}" Width="0.8*" MinWidth="80"/>
                        <DataGridTextColumn Header="PHÒNG" Binding="{Binding TenPhong}" Width="*"/>
                        <DataGridTextColumn Header="KHÁCH THUÊ" Binding="{Binding HoTenKhach}" Width="*"/>
                        <DataGridTextColumn Header="HẾT HẠN" Binding="{Binding NgayKetThuc}" Width="1.2*" MinWidth="120"/>
                        <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding TrangThai}" Width="1.2*" MinWidth="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Loading overlay -->
        <Grid Grid.RowSpan="5" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource Win11ContentBrush}" Opacity="0.7"/>
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Width="36" Height="36"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>

