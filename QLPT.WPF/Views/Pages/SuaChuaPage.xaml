<UserControl x:Class="QLPT.WPF.Views.Pages.SuaChuaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:QLPT.WPF.Controls"
             xmlns:vm="clr-namespace:QLPT.WPF.ViewModels">
    <UserControl.DataContext>
        <vm:SuaChuaViewModel/>
    </UserControl.DataContext>

    <ctl:CrudTable Margin="20,16,20,20"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                   ReloadCommand="{Binding LoadCommand}"
                   AddCommand="{Binding ThemCommand}"
                   EditCommand="{Binding CapNhatCommand}"
                   DeleteCommand="{Binding XoaCommand}"
                   IsBusy="{Binding IsBusy}"
                   ErrorMessage="{Binding ErrorMessage}"
                   AddLabel="Thêm yêu cầu"
                   EditLabel="Cập nhật trạng thái"
                   DeleteLabel="Xóa yêu cầu này"
                   SearchHint="Tìm theo mã, mô tả, trạng thái…">
        <ctl:CrudTable.Columns>
            <DataGridTextColumn Header="MÃ SC"           Binding="{Binding MaSuaChua}"     Width="0.8*" MinWidth="80"/>
            <DataGridTextColumn Header="MÃ HĐ"           Binding="{Binding MaHopDong}"     Width="0.8*" MinWidth="80"/>
            <DataGridTextColumn Header="MÔ TẢ"           Binding="{Binding MoTa}"          Width="*"/>
            <DataGridTextColumn Header="NGÀY YÊU CẦU"    Binding="{Binding NgayYeuCau}"    Width="1.3*" MinWidth="130"/>
            <DataGridTextColumn Header="NGÀY HOÀN THÀNH" Binding="{Binding NgayHoanThanh}" Width="1.3*" MinWidth="130"/>
            <DataGridTextColumn Header="CHI PHÍ"         Binding="{Binding ChiPhi}"        Width="1.2*" MinWidth="120"/>
            <DataGridTextColumn Header="TRẠNG THÁI"      Binding="{Binding TrangThai}"     Width="1.4*" MinWidth="140"/>
        </ctl:CrudTable.Columns>
    </ctl:CrudTable>
</UserControl>
