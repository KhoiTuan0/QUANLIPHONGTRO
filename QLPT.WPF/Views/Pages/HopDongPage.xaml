<UserControl x:Class="QLPT.WPF.Views.Pages.HopDongPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ctl="clr-namespace:QLPT.WPF.Controls">
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ctl:CrudTable Grid.Row="0"
                       ItemsSource="{Binding Items}"
                       SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                       ReloadCommand="{Binding LoadCommand}"
                       AddCommand="{Binding TaoHopDongCommand}"
                       ShowEdit="False"
                       ShowDelete="False"
                       IsBusy="{Binding IsBusy}"
                       ErrorMessage="{Binding ErrorMessage}"
                       AddLabel="Tạo HĐ"
                       SearchHint="Tìm theo mã HĐ, phòng, khách đại diện…">

            <!-- Nút nghiệp vụ riêng của trang hợp đồng -->
            <ctl:CrudTable.ExtraActions>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding GiaHanCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="36" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="CalendarClock" Width="16" Height="16"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="Gia hạn" Margin="6,0,0,0" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ThanhLyCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="36" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="FileSign" Width="16" Height="16"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="Thanh lý" Margin="6,0,0,0" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding XemSapHetHanCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="36" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="AlertCircle" Width="16" Height="16"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="Sắp hết hạn" Margin="6,0,0,0" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ctl:CrudTable.ExtraActions>

            <ctl:CrudTable.Columns>
                <DataGridTextColumn Header="MÃ HĐ"          Binding="{Binding MaHopDong}"           Width="0.8*" MinWidth="80"/>
                <DataGridTextColumn Header="MÃ PHÒNG"       Binding="{Binding MaPhong}"             Width="0.9*" MinWidth="90"/>
                <DataGridTextColumn Header="MÃ KH ĐẠI DIỆN" Binding="{Binding MaKhachDaiDien}"      Width="1.3*" MinWidth="130"/>
                <DataGridTextColumn Header="NGÀY BẮT ĐẦU"   Binding="{Binding NgayBatDau}"          Width="1.2*" MinWidth="120"/>
                <DataGridTextColumn Header="NGÀY KẾT THÚC"  Binding="{Binding NgayKetThuc}"         Width="1.2*" MinWidth="120"/>
                <DataGridTextColumn Header="GIÁ THUÊ/THÁNG" Binding="{Binding GiaThueThangDisplay}" Width="1.3*" MinWidth="130"/>
                <DataGridTextColumn Header="TIỀN CỌC"       Binding="{Binding TienCocDisplay}"      Width="1.2*" MinWidth="120"/>
                <DataGridTextColumn Header="TRẠNG THÁI"     Binding="{Binding TrangThai}"           Width="*"/>
            </ctl:CrudTable.Columns>
        </ctl:CrudTable>

        <!-- Bảng phụ: hợp đồng sắp hết hạn (bật/tắt bằng nút "Sắp hết hạn") -->
        <StackPanel Grid.Row="1"
                    Visibility="{Binding ShowSapHetHan, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Hợp đồng sắp hết hạn (30 ngày)"
                       FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8"
                       Foreground="{DynamicResource Win11TextPrimaryBrush}"/>
            <Border Background="{DynamicResource Win11SurfaceBrush}"
                    BorderBrush="{DynamicResource Win11BorderBrush}"
                    BorderThickness="1" CornerRadius="6">
                <DataGrid ItemsSource="{Binding SapHetHanItems}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" MaxHeight="200"
                          BorderThickness="0" Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="Transparent"
                          HorizontalGridLinesBrush="{DynamicResource Win11BorderBrush}"
                          VerticalGridLinesBrush="Transparent">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader"
                               BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource Win11BorderBrush}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Win11TextSecondaryBrush}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow"
                               BasedOn="{StaticResource AppDataGridRow}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Win11TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource Win11HoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource Win11AccentLightBrush}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Win11TextPrimaryBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell"
                               BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="14,9"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Win11TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Win11TextPrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MÃ HĐ"         Binding="{Binding MaHopDong}"   Width="0.8*" MinWidth="80"/>
                        <DataGridTextColumn Header="MÃ PHÒNG"      Binding="{Binding MaPhong}"     Width="0.9*" MinWidth="90"/>
                        <DataGridTextColumn Header="NGÀY KẾT THÚC" Binding="{Binding NgayKetThuc}" Width="1.3*" MinWidth="130"/>
                        <DataGridTextColumn Header="TRẠNG THÁI"    Binding="{Binding TrangThai}"   Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
