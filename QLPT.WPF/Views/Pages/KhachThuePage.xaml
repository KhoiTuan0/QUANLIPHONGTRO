<UserControl x:Class="QLPT.WPF.Views.Pages.KhachThuePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:QLPT.WPF.Controls"
             xmlns:vm="clr-namespace:QLPT.WPF.ViewModels">
    <UserControl.DataContext>
        <vm:KhachThueViewModel/>
    </UserControl.DataContext>

    <ctl:CrudTable Margin="20,16,20,20"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                   ReloadCommand="{Binding LoadCommand}"
                   AddCommand="{Binding AddCommand}"
                   EditCommand="{Binding EditCommand}"
                   DeleteCommand="{Binding DeleteCommand}"
                   IsBusy="{Binding IsBusy}"
                   ErrorMessage="{Binding ErrorMessage}"
                   AddLabel="Thêm khách thuê"
                   DeleteLabel="Xóa mềm khách thuê này"
                   SearchHint="Tìm theo tên, CCCD, SĐT, email…">
        <ctl:CrudTable.Columns>
            <DataGridTextColumn Header="MÃ"        Binding="{Binding MaKhach}"     Width="0.6*" MinWidth="60"/>
            <DataGridTextColumn Header="HỌ TÊN"    Binding="{Binding HoTen}"       Width="*"/>
            <DataGridTextColumn Header="CCCD"      Binding="{Binding Cccd}"        Width="1.3*" MinWidth="130"/>
            <DataGridTextColumn Header="SĐT"       Binding="{Binding SoDienThoai}" Width="1.2*" MinWidth="120"/>
            <DataGridTextColumn Header="GIỚI TÍNH" Binding="{Binding GioiTinh}"    Width="0.9*" MinWidth="90"/>
            <DataGridTextColumn Header="EMAIL"     Binding="{Binding Email}"       Width="*"/>
            <DataGridTextColumn Header="ĐỊA CHỈ"   Binding="{Binding DiaChi}"      Width="*"/>
        </ctl:CrudTable.Columns>
    </ctl:CrudTable>
</UserControl>
