<UserControl x:Class="QLPT.WPF.Views.Pages.ViPhamPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:QLPT.WPF.Controls"
             xmlns:vm="clr-namespace:QLPT.WPF.ViewModels">
    <UserControl.DataContext>
        <vm:ViPhamViewModel/>
    </UserControl.DataContext>

    <!-- Quy trình: Thêm vi phạm → nút ✏️ "Xử lý" trên từng dòng → thông báo cho khách -->
    <ctl:CrudTable Margin="20,16,20,20"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                   ReloadCommand="{Binding LoadCommand}"
                   AddCommand="{Binding ThemCommand}"
                   EditCommand="{Binding XuLyCommand}"
                   DeleteCommand="{Binding XoaCommand}"
                   IsBusy="{Binding IsBusy}"
                   ErrorMessage="{Binding ErrorMessage}"
                   AddLabel="Thêm vi phạm"
                   EditLabel="Xử lý vi phạm"
                   DeleteLabel="Xóa vi phạm này"
                   SearchHint="Tìm theo phòng, khách, nội dung, trạng thái…">
        <ctl:CrudTable.Columns>
            <DataGridTextColumn Header="MÃ VP"       Binding="{Binding MaViPham}"     Width="0.6*" MinWidth="60"/>
            <DataGridTextColumn Header="MÃ HĐ"       Binding="{Binding MaHopDong}"    Width="0.6*" MinWidth="60"/>
            <DataGridTextColumn Header="PHÒNG"       Binding="{Binding TenPhong}"     Width="0.9*" MinWidth="90"/>
            <DataGridTextColumn Header="KHÁCH"       Binding="{Binding TenKhach}"     Width="1.2*" MinWidth="120"/>
            <DataGridTextColumn Header="NỘI DUNG"    Binding="{Binding NoiDung}"      Width="2*"   MinWidth="160"/>
            <DataGridTextColumn Header="NGÀY"        Binding="{Binding NgayViPham}"   Width="0.9*" MinWidth="90"/>
            <DataGridTextColumn Header="TIỀN PHẠT"   Binding="{Binding MucPhat}"      Width="1*"   MinWidth="100"/>
            <DataGridTextColumn Header="XỬ LÝ"       Binding="{Binding HinhThucXuLy}" Width="1.1*" MinWidth="110"/>
            <DataGridTextColumn Header="TRẠNG THÁI"  Binding="{Binding TrangThai}"    Width="1*"   MinWidth="100"/>
        </ctl:CrudTable.Columns>
    </ctl:CrudTable>
</UserControl>
