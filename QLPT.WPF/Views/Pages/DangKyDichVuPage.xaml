<UserControl x:Class="QLPT.WPF.Views.Pages.DangKyDichVuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ctl="clr-namespace:QLPT.WPF.Controls"
             xmlns:vm="clr-namespace:QLPT.WPF.ViewModels">
    <UserControl.DataContext>
        <vm:DangKyDichVuViewModel/>
    </UserControl.DataContext>

    <ctl:CrudTable Margin="20,16,20,20"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                   ReloadCommand="{Binding LoadCommand}"
                   AddCommand="{Binding DangKyCommand}"
                   IsBusy="{Binding IsBusy}"
                   ErrorMessage="{Binding ErrorMessage}"
                   AddLabel="Đăng ký dịch vụ"
                   ShowEdit="False"
                   ShowDelete="False"
                   SearchHint="Tìm theo tên dịch vụ, mã đăng ký…">

        <!-- Bộ lọc riêng của trang: chọn hợp đồng cần xem -->
        <ctl:CrudTable.ExtraFilter>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Text="{Binding MaHopDong, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="Mã hợp đồng"
                         Width="200" VerticalAlignment="Center"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                <Button Command="{Binding LoadCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="36" Padding="12,0" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="DatabaseSearch" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Tải" Margin="6,0,0,0" FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ctl:CrudTable.ExtraFilter>

        <!-- Nghiệp vụ riêng: ngừng dịch vụ của dòng đang chọn -->
        <ctl:CrudTable.ExtraActions>
            <Button Command="{Binding NgungCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Height="36" Padding="12,0"
                    Foreground="#EF4444" BorderBrush="#EF4444">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Cancel" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Ngừng dịch vụ" Margin="6,0,0,0" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </ctl:CrudTable.ExtraActions>

        <ctl:CrudTable.Columns>
            <DataGridTextColumn Header="MÃ ĐK"         Binding="{Binding MaDangKy}"    Width="0.8*" MinWidth="80"/>
            <DataGridTextColumn Header="MÃ HĐ"         Binding="{Binding MaHopDong}"   Width="0.8*" MinWidth="80"/>
            <DataGridTextColumn Header="MÃ DV"         Binding="{Binding MaDichVu}"    Width="0.8*" MinWidth="80"/>
            <DataGridTextColumn Header="TÊN DỊCH VỤ"   Binding="{Binding TenDichVu}"   Width="*"/>
            <DataGridTextColumn Header="NGÀY BẮT ĐẦU"  Binding="{Binding NgayBatDau}"  Width="1.3*" MinWidth="130"/>
            <DataGridTextColumn Header="NGÀY KẾT THÚC" Binding="{Binding NgayKetThuc}" Width="1.3*" MinWidth="130"/>
            <DataGridTextColumn Header="TRẠNG THÁI"    Binding="{Binding TrangThai}"   Width="1.2*" MinWidth="120"/>
        </ctl:CrudTable.Columns>
    </ctl:CrudTable>
</UserControl>
