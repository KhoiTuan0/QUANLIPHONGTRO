<UserControl x:Class="QLPT.WPF.Views.Pages.TaiSanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:QLPT.WPF.Controls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QLPT.WPF.ViewModels">
    <UserControl.DataContext>
        <vm:TaiSanViewModel/>
    </UserControl.DataContext>
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: All TaiSan -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Command="{Binding LoadAllCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center"/>
                            <TextBlock Text="Tải lại" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddTaiSanCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"
                            Visibility="{Binding CanManageStock, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Plus" VerticalAlignment="Center"/>
                            <TextBlock Text="Thêm tài sản mẫu" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NhapKhoCommand}" Content="Nhập kho"
                            Visibility="{Binding CanManageStock, Converter={StaticResource BoolToVis}}"
                            ToolTip="Chọn mẫu rồi nhập số lượng một lần; mỗi hiện vật được cấp mã riêng."
                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                    <Button Command="{Binding GanVaoPhongCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Visibility="{Binding CanManageStock, Converter={StaticResource BoolToVis}}"
                            ToolTip="Ghi nhận hiện vật mới mua và đưa thẳng vào phòng, không lấy từ tồn kho.">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ArrowRight" VerticalAlignment="Center"/>
                            <TextBlock Text="Ghi nhận tại phòng" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <md:Card Grid.Row="1" UniformCornerRadius="12" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Danh sách tài sản mẫu · chọn một dòng để xem từng hiện vật" FontWeight="SemiBold"
                                   Margin="16,12,0,8" FontSize="14"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding AllItems}" SelectedItem="{Binding SelectedItem}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                   BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding MaTaiSan}" Width="0.6*" MinWidth="60"/>
                                <DataGridTextColumn Header="Tên tài sản" Binding="{Binding TenTaiSan}" Width="*"/>
                                <DataGridTextColumn x:Name="TonKhoColumn" Header="Tồn kho" Binding="{Binding TonKhoDisplay}" Width="75"/>
                                <DataGridTextColumn x:Name="TrongPhongColumn" Header="Trong phòng" Binding="{Binding TrongPhongDisplay}" Width="85"/>
                                <DataGridTextColumn Header="Giá trị tham khảo" Binding="{Binding GiaTriDisplay}" Width="1.4*" MinWidth="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>
            </Grid>

            <!-- Right: TaiSan in phong -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <ctl:EntityPicker Source="Phong" Hint="Phòng cần xem" SearchHint="Tìm tên phòng, cơ sở hoặc mã" SelectedId="{Binding MaPhongInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="0,0,8,0"/>
                    <Button Command="{Binding LoadPhongCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Magnify" VerticalAlignment="Center"/>
                            <TextBlock Text="Tải" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Xem tất cả hiện vật" Command="{Binding LoadCaTheAllCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                <md:Card Grid.Row="0" UniformCornerRadius="12" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Số lượng theo mẫu trong phòng" FontWeight="SemiBold"
                                   Margin="16,12,0,8" FontSize="14"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding PhongItems}" SelectedItem="{Binding SelectedPhongItem}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                   BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding MaTaiSanPhong}" Width="0.6*" MinWidth="60"/>
                                <DataGridTextColumn Header="Tên tài sản" Binding="{Binding TenTaiSan}" Width="*"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="0.8*" MinWidth="80"/>
                                <DataGridTextColumn Header="Tình trạng" Binding="{Binding TinhTrang}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>
                <md:Card Grid.Row="2" UniformCornerRadius="12" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="16,8,12,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Xem lịch sử / ghi nhận sửa chữa"
                                        Command="{Binding XemLichSuCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                <TextBlock Text="{Binding CaTheTitle}" FontWeight="SemiBold" FontSize="14"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                        Visibility="{Binding CanManageStock, Converter={StaticResource BoolToVis}}">
                                <Button Content="Chuyển số lượng từ kho" Margin="0,0,8,0"
                                        ToolTip="Chọn mẫu và phòng, nhập số lượng cần chuyển; tồn kho sẽ giảm tương ứng."
                                        Command="{Binding XuatKhoNhieuCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                <Button Content="Gỡ hiện vật về kho" Margin="0,0,8,0"
                                        ToolTip="Chọn hiện vật đang sử dụng trong phòng chưa có hợp đồng hiệu lực."
                                        Command="{Binding GoCaTheVeKhoCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                <Button Content="Đưa từ kho vào phòng"
                                        ToolTip="Chọn phòng, bấm Xem tất cả hiện vật rồi chọn một hiện vật Trong kho. Chỉ dùng cho phòng chưa có hợp đồng hiệu lực."
                                        Command="{Binding DuaTuKhoVaoPhongCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </StackPanel>
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding CaTheItems}" SelectedItem="{Binding SelectedCaTheItem}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã hiện vật" Binding="{Binding MaDinhDanh}" Width="125"/>
                                <DataGridTextColumn Header="Tên" Binding="{Binding TenTaiSan}" Width="*"/>
                                <DataGridTextColumn Header="Cơ sở" Binding="{Binding TenCoSo}" Width="110"/>
                                <DataGridTextColumn Header="Phòng" Binding="{Binding TenPhong}" Width="75"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="100"/>
                                <DataGridTextColumn Header="Tình trạng" Binding="{Binding TinhTrang}" Width="*"/>
                                <DataGridTextColumn Header="Số lần sửa" Binding="{Binding SoLanSua}" Width="85"/>
                                <DataGridTextColumn Header="Chi phí sửa" Binding="{Binding TongChiPhiSua}" Width="115"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>
                </Grid>
            </Grid>
        </Grid>

        <!-- Error + Loading -->
        <TextBlock Grid.Row="0" Grid.RowSpan="1" Text="{Binding ErrorMessage}" Foreground="Crimson"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,8" TextWrapping="Wrap" MaxWidth="400"/>
        <Grid Grid.RowSpan="1" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource Win11ContentBrush}" Opacity="0.6"/>
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Width="48" Height="48"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>

